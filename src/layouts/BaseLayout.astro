---
import ChatWidget from '@/components/ChatWidget.astro';
import { assetVersion } from '@/utils/assets';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Iglesia Presbiteriana Reformada Gethsemaní',
  description = 'Iglesia Presbiteriana Reformada Gethsemaní en Coyoacán. Una iglesia confesional centrada en Cristo y en su Palabra.',
  image = '/images/og/default.jpg',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = 'Iglesia Presbiteriana Reformada Gethsemaní',
  canonicalPath = '/',
  ogType = 'website',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://iglesia-gethsemani.github.io';
const base = import.meta.env.BASE_URL;
const pageTitle = title.includes('Gethsemaní') ? title : `${title} | Iglesia Presbiteriana Reformada Gethsemaní`;
const canonicalUrl = new URL(canonicalPath.replace(/^\//, ''), `${site}${base}`).href;
const ogImage = image.startsWith('http') ? image : new URL(image.replace(/^\//, ''), `${site}${base}`).href;
const logoUrl = new URL('images/optimized/logo-gethsemani-240.webp', `${site}${base}`).href;
const churchSchema = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: 'Iglesia Presbiteriana Reformada Gethsemaní',
  url: `${site}${base === '/' ? '/' : base}`,
  logo: logoUrl,
  sameAs: [
    'https://www.facebook.com/iprm.gethsemani',
    'https://www.youtube.com/@i.p.r.m.gethsemani',
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Iglesia Presbiteriana Reformada Gethsemaní" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content="RbaQ1oJ7DiOYhGZav_rs-bkQ42MVvWKnDLZxa6V6KWg" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/png" href={`${base}favicon-256.png`} sizes="256x256" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    {
      canonicalPath === '/' && (
        <>
          <link
            rel="preload"
            as="image"
            type="image/webp"
            href={`${base}images/optimized/templo-gethsemani-640.webp`}
            media="(max-width: 900px)"
            fetchpriority="high"
          />
          <link
            rel="preload"
            as="image"
            type="image/webp"
            href={`${base}images/optimized/templo-gethsemani-1024.webp`}
            media="(min-width: 901px)"
            fetchpriority="high"
          />
        </>
      )
    }
    <link
      rel="preload"
      href={`${base}fonts/manrope-400-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="stylesheet"
      href={`${base}styles/fonts.css?v=${assetVersion}`}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={`${base}styles/fonts.css?v=${assetVersion}`} />
    </noscript>
    <link rel="stylesheet" href={`${base}styles/global.css?v=${assetVersion}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(churchSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="topbar">
      <div>Cuauhtémoc 117 · Coyoacán, CDMX</div>
      <div>Domingos desde las 9:30 h</div>
    </div>
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
    <ChatWidget />
    <script is:inline src={`${base}scripts/site.js?v=${assetVersion}`} defer></script>
  </body>
</html>
