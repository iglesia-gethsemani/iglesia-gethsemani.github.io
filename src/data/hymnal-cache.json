{
  "hymn-23": {
    "id": "hymn-23",
    "kind": "hymn",
    "number": 23,
    "title": "Himno 23",
    "subtitle": "Te loamos, oh Dios",
    "intro": "Dad a Jehová la gloria debida a su nombre. Sal. 29.2",
    "authors": [
      "LETRA: William P. Mackay, trad. Howard W. Cragin",
      "MÚSICA: John J. Husband, 1815"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Te loamos, oh Dios,",
          "nuestro Padre de amor,",
          "pues en Cristo, tu Hijo,",
          "nos diste perdón."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Aleluya, te alabamos,",
          "oh, cuan grande es tu amor.",
          "Aleluya, te adoramos,",
          "bendito Señor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Te loamos, Jesús,",
          "pues tu trono de luz",
          "tú dejaste por darnos",
          "salud en la cruz."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Te damos loor,",
          "Santo Consolador,",
          "que nos llenas de gozo",
          "y santo valor."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Unidos load",
          "a la gran Trinidad,",
          "que es la fuente de gracia,",
          "poder y verdad."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-366": {
    "id": "hymn-366",
    "kind": "hymn",
    "number": 366,
    "title": "Himno 366",
    "subtitle": "Dios cuidará de ti",
    "intro": "Santificados en Dios Padre, y guardados en Jesucristo. Jud. 1",
    "authors": [
      "LETRA: Civilla D. Martin, trad. Vicente Mendoza",
      "MÚSICA: W. Stillman Martin"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "En tus afanes y en tu dolor",
          "Dios cuidará de ti;",
          "vive amparado en su inmenso amor,",
          "Dios cuidará de ti."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Dios cuidará de ti",
          "y por doquier contigo irá;",
          "Dios cuidará de ti,",
          "nada te faltará."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Si desfalleces en tu labor",
          "Dios cuidará de ti;",
          "si ves peligros en derredor,",
          "Dios cuidará de ti."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Nunca en la prueba sucumbirás,",
          "Dios cuidará de ti;",
          "en su regazo te apoyarás,",
          "Dios cuidará de ti."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-438": {
    "id": "hymn-438",
    "kind": "hymn",
    "number": 438,
    "title": "Himno 438",
    "subtitle": "Los panes y los peces",
    "intro": "Aquí está un muchacho que tiene cinco panes de cebada y dos pececillos. Jn. 6.9",
    "authors": [
      "LETRA Y MÚSICA: Samuel Pascoe, arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Un niño le dio al Señor",
          "sus panes y sus peces;",
          "el Señor los multiplicó",
          "y a multitud alimentó."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Trae tus panes y tus peces",
          "al Señor, y él multiplicará.",
          "Trae tus panes y tus peces",
          "al Señor, y él multiplicará."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Si tú dejas que él",
          "tome tu corazón,",
          "el Señor te bendecirá",
          "y la vida él te dará."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-446": {
    "id": "hymn-446",
    "kind": "hymn",
    "number": 446,
    "title": "Himno 446",
    "subtitle": "Dale tu ofrenda al Señor",
    "intro": "Di a los hijos de Israel que tomen para mí ofrenda de su voluntad, de corazón.",
    "authors": [
      "LETRA Y MÚSICA: Autor desconocido, arr. Jean Legters"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dale tu ofrenda al Señor,",
          "dásela de corazón;",
          "que cuando el cielo reclame",
          "le respondas con amor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Que no te quede el dolor",
          "cuando hayas ofrendado;",
          "/Dios bendice al dador alegre,",
          "multiplica lo que has dado./"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-450": {
    "id": "hymn-450",
    "kind": "hymn",
    "number": 450,
    "title": "Himno 450",
    "subtitle": "Dios te bendiga",
    "intro": "Jehová te bendiga y te guarde.",
    "authors": [
      "LETRA: Epigmenio Velasco",
      "MÚSICA: Frederick Atkinson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dios te bendiga, protección te dé,",
          "sea su gracia siempre tu sostén;",
          "su ángel velando a tu redor esté,",
          "dándote abrigo por doquier.",
          "Amén. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-526": {
    "id": "hymn-526",
    "kind": "hymn",
    "number": 526,
    "title": "Himno 526",
    "subtitle": "Da lo mejor al Maestro",
    "intro": "Abel ofreció a Dios más excelente sacrificio que Caín. Heb. 11.4",
    "authors": [
      "LETRA: Howard B. Grose, trad. Vicente Mendoza",
      "MÚSICA: Charlotte A. Barnard"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Da lo mejor al Maestro,",
          "dalo en ofrenda de amor;",
          "él es el único digno",
          "de recibir lo mejor.",
          "Dale tu esfuerzo y tu vida,",
          "dale tu celo y virtud,",
          "dale tu fe no fingida,",
          "todo en humilde actitud."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Da lo mejor al Maestro,",
          "él es tu Rey y Señor;",
          "dalo al Señor, nada es nuestro,",
          "todo en ofrenda de amor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Da la mejor al Maestro,",
          "dale la flor de tu edad,",
          "y haz de tu años maduros",
          "fruto de santa piedad.",
          "Dale una noble obediencia,",
          "dale un ardiente fervor,",
          "dale una limpia conciencia,",
          "dale tu heroico valor."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-588": {
    "id": "hymn-588",
    "kind": "hymn",
    "number": 588,
    "title": "Himno 588",
    "subtitle": "Fija tus ojos en Cristo",
    "intro": "Habitó entre nosotros, lleno de gracia y de verdad. Jn. 1.14",
    "authors": [
      "LETRA Y MÚSICA: Helen H. Lemmel, trad. C. P. Denyer"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Oh, alma cansada y turbada,",
          "¿sin luz en tu senda andarás?",
          "Al Salvador mira y vive,",
          "del mundo la luz es su faz."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Fija tus ojos en Cristo,",
          "tan lleno de gracia y amor,",
          "y lo terrenal su valor tendrá",
          "a la luz del glorioso Señor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "De muerte a vida eterna",
          "te llama el Salvador fiel.",
          "En ti no domine el pecado,",
          "hay siempre victoria en él."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Jamás faltará su promesa:",
          "“He aquí, yo contigo estoy”.",
          "Al mundo perdido, aprisa,",
          "anuncia la salvación hoy."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-600": {
    "id": "hymn-600",
    "kind": "hymn",
    "number": 600,
    "title": "Himno 600",
    "subtitle": "Firmes y adelante",
    "intro": "No temáis; estad firmes, y ved la salvación que Jehová hará hoy con vosotros. Ex. 14.13",
    "authors": [
      "LETRA: Sabine Baring-Gould, 1865, trad. Juan B. Cabrera",
      "MÚSICA: Arthur S. Sullivan, 1871"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Firmes y adelante,",
          "huestes de la fe,",
          "sin temor alguno",
          "que Jesús nos ve;",
          "jefe soberano,",
          "Cristo al frente va,",
          "y la regia enseña",
          "tremolando está."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Firmes y adelante,",
          "huestes de la fe,",
          "sin temor alguno",
          "que Jesús nos ve."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Al sagrado nombre",
          "de nuestro adalid",
          "tiembla el enemigo",
          "y huye de la lid.",
          "Nuestra es la victoria,",
          "dad a Dios loor,",
          "y óigalo el averno",
          "lleno de pavor."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Muévese potente",
          "la iglesia de Dios;",
          "de los ya gloriosos",
          "marchamos en pos;",
          "somos sólo un cuerpo",
          "y uno es el Señor,",
          "una es la esperanza",
          "y uno nuestro amor."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Tronos y coronas",
          "pueden perecer,",
          "de Jesús la iglesia",
          "constante ha de ser;",
          "nada en contra suya",
          "prevalecerá,",
          "porque la promesa",
          "nunca faltará."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-624": {
    "id": "hymn-624",
    "kind": "hymn",
    "number": 624,
    "title": "Himno 624",
    "subtitle": "Mi México",
    "intro": "Mira desde tu morada santa, y bendice a tu pueblo.Dt. 26.15",
    "authors": [
      "LETRA: Gonzalo Báez Camargo",
      "MÚSICA: Samuel A. Ward"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Un cielo tiende sobre ti",
          "su manto azul turquí,",
          "dos mares cantan tu loor,",
          "oh Patria de mi amor.",
          "Mi México, mi México,",
          "bendígate el Señor,",
          "su gracia dé hasta rebosar",
          "del uno al otro mar."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Mil héroes viste combatir,",
          "peleando hasta el morir,",
          "y conquistar con dignidad",
          "tu santa libertad.",
          "Mi México, mi México,",
          "Dios premie tu valor,",
          "tu noble sangre sea feraz",
          "y logre eterna paz."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Oh Patria, llena de dolor,",
          "la negra esclavitud",
          "del fanatismo y el error",
          "opaca tu virtud.",
          "Mi México, mi México,",
          "bendígate el Señor;",
          "verás tu noche terminar",
          "y el nuevo día brillar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Como la nube que alumbró",
          "al pueblo de Israel,",
          "la Santa Biblia, luz de Dios,",
          "te guíe siempre a él.",
          "Mi México, mi México,",
          "que Dios contigo esté,",
          "y la palabra de verdad",
          "te dé la libertad."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-76": {
    "id": "hymn-76",
    "kind": "hymn",
    "number": 76,
    "title": "Himno 76",
    "subtitle": "¡A Dios adorad!",
    "intro": "Ahora pues, Dios  nuestro , nosotros alabamos y loamos tu glorioso nombre. 1 Cr. 29:13",
    "authors": [
      "LETRA: Leonard S. Ingram",
      "MÚSICA: Atrib. a J. Michael Haydn, en Sacred Melodies de William Gardiner, 1815"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "¡A Dios adorad!",
          "¡Mortales, cantad!",
          "Su nombre glorioso",
          "Con himnos load;",
          "Potente es su diestra,",
          "Su infinito amor,",
          "Su luz esplendente,",
          "Divino fulgor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "¡A Dios adorad!",
          "¡Sus hechos cantad!",
          "Su trono fundado",
          "En juicio y verdad;",
          "Los cielos, el campo,",
          "El aire y la mar",
          "Denuncian la gloria",
          "Del grande Jehová."
        ]
      },
      {
        "name": "3",
        "lines": [
          "¡A Dios adorad!",
          "Su fidelidad",
          "Es base segura",
          "Por la eternidad;",
          "Amigo que imparte",
          "Su gracia y favor,",
          "Defensa y escudo",
          "Es nuestro Creador."
        ]
      },
      {
        "name": "4",
        "lines": [
          "¡A Dios adorad!",
          "Su nombre enzalzad,",
          "Oh cielos y tierra",
          "Su gloria cantad;",
          "Rendid hoy humildes",
          "Un culto veraz",
          "Y deje en nuestra alma",
          "Perdón, gracia y paz."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
