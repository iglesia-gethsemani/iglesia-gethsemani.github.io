{
  "hymn-314": {
    "id": "hymn-314",
    "kind": "hymn",
    "number": 314,
    "title": "Himno 314",
    "subtitle": "Cerca de ti, Señor",
    "intro": "¿Quién morará en tu monte santo? Sal. 15.1",
    "authors": [
      "LETRA: Sara F. Adams, trad. Thomas M. Westrup",
      "MÚSICA: Lowell Mason"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Cerca de ti, Señor,",
          "quiero morar;",
          "lo tierno de tu amor",
          "quiero gozar.",
          "Llena mi pobre ser,",
          "limpia mi corazón,",
          "hazme tu rostro ver",
          "en tu mansión."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Pasos inciertos doy,",
          "el sol se va;",
          "mas si contigo estoy",
          "no temo ya.",
          "Himnos de gratitud",
          "ferviente cantaré",
          "y fiel a ti, Jesús,",
          "siempre seré."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Día feliz veré",
          "creyendo en ti,",
          "en que habitaré",
          "cerca de ti.",
          "Mi voz alabará",
          "tu dulce nombre allí,",
          "y mi alma gozará",
          "cerca de ti."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-341": {
    "id": "hymn-341",
    "kind": "hymn",
    "number": 341,
    "title": "Himno 341",
    "subtitle": "Vivir por Cristo",
    "intro": "Para mí el vivir es Cristo. Flp. 1.21",
    "authors": [
      "LETRA: Thomas O. Chisholm, trad. Eleazar Z. Pérez",
      "MÚSICA: C. Harold Lowden, 1915"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Vivir por Cristo",
          "en pureza y verdad,",
          "siempre agradarle",
          "con todo mi afán,",
          "dándole gloria",
          "y continuo loor",
          "es ofrendarle",
          "mi ferviente amor."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Jesús, Señor y amigo,",
          "¿qué pides tú de mí?",
          "Por mí en la cruz moriste,",
          "me entrego todo a ti;",
          "sé tú mi eterno dueño",
          "en horas de ansiedad,",
          "hasta llegar gozoso",
          "a la patria celestial."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Vivir por Cristo,",
          "que obró redención",
          "al expirar por",
          "mi culpa y pasión;",
          "tan grande amor",
          "me constriñe a la lid,",
          "por sus pisadas",
          "la lucha seguir."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Vivir por Cristo,",
          "doquiera yo esté,",
          "para su gloria,",
          "cumpliendo el deber;",
          "en mis tristezas",
          "y cruel ansiedad,",
          "sumiso siempre",
          "a su voluntad."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Vivir por Cristo",
          "la vida al cruzar;",
          "él mi tesoro,",
          "mi gloria y solaz;",
          "al extraviado",
          "llevar al redil,",
          "para que encuentre",
          "con él dichas mil."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-446": {
    "id": "hymn-446",
    "kind": "hymn",
    "number": 446,
    "title": "Himno 446",
    "subtitle": "Dale tu ofrenda al Señor",
    "intro": "Di a los hijos de Israel que tomen para mí ofrenda de su voluntad, de corazón.",
    "authors": [
      "LETRA Y MÚSICA: Autor desconocido, arr. Jean Legters"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dale tu ofrenda al Señor,",
          "dásela de corazón;",
          "que cuando el cielo reclame",
          "le respondas con amor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Que no te quede el dolor",
          "cuando hayas ofrendado;",
          "/Dios bendice al dador alegre,",
          "multiplica lo que has dado./"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-450": {
    "id": "hymn-450",
    "kind": "hymn",
    "number": 450,
    "title": "Himno 450",
    "subtitle": "Dios te bendiga",
    "intro": "Jehová te bendiga y te guarde.",
    "authors": [
      "LETRA: Epigmenio Velasco",
      "MÚSICA: Frederick Atkinson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dios te bendiga, protección te dé,",
          "sea su gracia siempre tu sostén;",
          "su ángel velando a tu redor esté,",
          "dándote abrigo por doquier.",
          "Amén. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-51": {
    "id": "hymn-51",
    "kind": "hymn",
    "number": 51,
    "title": "Himno 51",
    "subtitle": "Porque tú eres bueno",
    "intro": "Jehová es bueno, porque para siempre es su misericordia.",
    "authors": [
      "LETRA Y MÚSICA: Gustavo E. Ordoñez, Pablo Bravo y Daniel Hernandez, arr, Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Porque tú eres bueno,",
          "Porque para siempre",
          "Tu misericordia es;",
          "Cada mañana al despertar,",
          "Sé que en ti puedo confiar;",
          "Me sostienes por tu gran fidelidad."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Porque tú eres bueno,",
          "Porque tu justicia,",
          "Justicia eterna es,",
          "Y en ella yo me deleitaré,",
          "En tu verdad caminaré;",
          "Por tu senda de justicia",
          "Guíame."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-52": {
    "id": "hymn-52",
    "kind": "hymn",
    "number": 52,
    "title": "Himno 52",
    "subtitle": "Tu fidelidad",
    "intro": "Tu fidelidad alcanza hasta las nubes.",
    "authors": [
      "LETRA Y MÚSICA: Miguel Cassina, arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Tu fidelidad es grande,",
          "Tu fidelidad incomparable es;",
          "Nadie como tú, bendito Dios,",
          "Grande es tu fidelidad.",
          "(se canta tres veces)"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-520": {
    "id": "hymn-520",
    "kind": "hymn",
    "number": 520,
    "title": "Himno 520",
    "subtitle": "¡Oh, que amigo nos es cristo!",
    "intro": "Por nada estéis afanosos, sino sean conocidas vuestras peticiones. Flp. 4.6",
    "authors": [
      "LETRA: Joseph Scriven, 1855, trad. Leandro Garza Mora",
      "MÚSICA: Charles C. Converse"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "¡Oh, qué amigo nos es Cristo!",
          "Él llevó nuestro dolor,",
          "él nos manda que llevemos",
          "todo a Dios en oración.",
          "¿Está el hombre desprovisto",
          "de paz, gozo y santo amor?",
          "Esto es porque no llevamos",
          "todo a Dios en oración."
        ]
      },
      {
        "name": "2",
        "lines": [
          "¿Estás débil y cargado",
          "de cuidados y temor?",
          "A Jesús, refugio eterno,",
          "dile todo en oración.",
          "¿Te desprecian tus amigos?",
          "Cuéntaselo en oración;",
          "en sus brazos de amor tierno,",
          "paz tendrá tu corazón."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Jesucristo es nuestro amigo:",
          "de esto prueba nos mostró,",
          "pues para llevar consigo",
          "al culpable, se humanó.",
          "El castigo de su pueblo",
          "en su muerte él sufrió;",
          "Cristo es un amigo eterno,",
          "sólo en él confío yo."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-589": {
    "id": "hymn-589",
    "kind": "hymn",
    "number": 589,
    "title": "Himno 589",
    "subtitle": "Jesús es la luz del mundo",
    "intro": "Yo, la luz, he venido al mundo, para que todo aquel que cree en mí no permanezca en tinieblas. Jn. 12.46",
    "authors": [
      "LETRA Y MÚSICA: Philip P. Bliss, trad. Henry C. Thompson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "El mundo perdido",
          "en pecado se vio:",
          "Jesús es la luz del mundo;",
          "mas en las tinieblas",
          "la gloria brilló:",
          "Jesús es la luz del mundo."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "¡Ven a la luz; no quieras perder",
          "gozo perfecto al amanecer!",
          "Yo ciego fui, mas ya puedo ver.",
          "¡Jesús es la luz del mundo!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "Vivir en él vuelve",
          "la noche en día:",
          "Jesús es la luz del mundo;",
          "andemos en luz",
          "y sigamos al guía:",
          "Jesús es la luz del mundo."
        ]
      },
      {
        "name": "3",
        "lines": [
          "¡Oh ciegos y presos",
          "del lóbrego error!",
          "Jesús es la luz del mundo;",
          "él manda lavaros",
          "y ver su fulgor:",
          "Jesús es la luz del mundo."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Ni soles ni lunas",
          "el cielo tendrá:",
          "Jesús es la luz del mundo;",
          "la luz de su rostro",
          "lo iluminará:",
          "Jesús es la luz del mundo."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-79": {
    "id": "hymn-79",
    "kind": "hymn",
    "number": 79,
    "title": "Himno 79",
    "subtitle": "Con  cánticos, Señor",
    "intro": "Cantando con gracia en vuestros corazones al Señor con cánticos. Col. 3:16",
    "authors": [
      "LETRA: James J. Cummings, 1893, trad. Merrel N. Hutchinson, 1877",
      "MÚSICA: John Darwall, 1770"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Con  cánticos, Señor,",
          "Mi corazón y voz",
          "Te adoran con fervor,",
          "Oh trino, santo Dios."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "En tu mansión yo te veré",
          "Y paz eterna gozaré."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Tu mano paternal",
          "Marcó mi senda aquí;",
          "Mis pasos, cada cual,",
          "Velados son por ti."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Innumerables son",
          "Tus bienes y sin par,",
          "y por tu compasión",
          "los gozo sin cesar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Tú eres. Oh Señor,",
          "Mi sumo, todo bien;",
          "Mil lenguas tu amor",
          "Cantando siempre estén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
