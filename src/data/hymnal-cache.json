{
  "hymn-221": {
    "id": "hymn-221",
    "kind": "hymn",
    "number": 221,
    "title": "Himno 221",
    "subtitle": "A Cristo coronad",
    "intro": "Digno eres de tomar el libro y de abrir sus sellos. Ap. 5.9",
    "authors": [
      "LETRA: Est. 1, 2 Matthew Bridges 1851, est. 3 Godfrey Thring 1874, trad. E. A. Strange",
      "MÚSICA: George J. Elvey"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "A Cristo coronad,",
          "divino Salvador;",
          "sentado en alta majestad",
          "es digno de loor;",
          "al Rey de gloria y paz",
          "loores tributad,",
          "y bendecid al inmortal",
          "por toda la eternidad."
        ]
      },
      {
        "name": "2",
        "lines": [
          "A Cristo coronad,",
          "Señor de nuestro amor;",
          "al Rey triunfante celebrad,",
          "glorioso vencedor;",
          "potente Rey de paz,",
          "el triunfo consumó,",
          "y por su muerte de dolor",
          "su grande amor mostró."
        ]
      },
      {
        "name": "3",
        "lines": [
          "A Cristo coronad,",
          "Señor de vida y luz;",
          "con alabanzas proclamad",
          "los triunfos de la cruz;",
          "a él solo adorad,",
          "Señor de salvación;",
          "loor eterno tributad",
          "de todo corazón."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-30": {
    "id": "hymn-30",
    "kind": "hymn",
    "number": 30,
    "title": "Himno 30",
    "subtitle": "Sólo a ti, Dios y Señor",
    "intro": "Al Señor tu Dios adorarás, y a él sólo servirás. Mt. 4:10",
    "authors": [
      "LETRA: Pedro Castro",
      "MÚSICA: En Lyra Davídica, Londres, 1708"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Sólo a ti, Dios y Señor,",
          "adoramos, adoramos,",
          "y la gloria y el honor",
          "tributamos, tributamos;",
          "sólo a Cristo, nuestra luz,",
          "acudimos, acudimos,",
          "por su muerte en la cruz",
          "revivimos, revivimos."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Un Espíritu, no más,",
          "nos gobierna, nos gobierna,",
          "y con él, Señor, nos das",
          "paz eterna, paz eterna;",
          "él es fuego celestial,",
          "cuya llama, cuya llama",
          "en amor angelical",
          "nos inflama, nos inflama."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Disfrutamos tu favor",
          "solamente, solamente",
          "por Jesús, fuente de amor",
          "permanente, permanente;",
          "sólo él nos libertó",
          "de la muerte, de la muerte,",
          "sólo él se declaró",
          "nuestro fuerte, nuestro fuerte."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Sólo tú, oh Creador,",
          "Dios eterno, Dios eterno,",
          "nos libraste del furor",
          "del infierno, del infierno",
          "y por esto con placer",
          "proclamamos, proclamamos",
          "que sólo en tu gran poder",
          "confiamos, confiamos."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-333": {
    "id": "hymn-333",
    "kind": "hymn",
    "number": 333,
    "title": "Himno 333",
    "subtitle": "Cerca, más cerca",
    "intro": "Habéis sido hechos cercanos por la sangre de Cristo. Col. 2.13",
    "authors": [
      "LETRA Y MÚSICA: Lelia N. Morris, trad. Vicente Mendoza, 1911"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Cerca, más cerca,",
          "oh Dios, de ti;",
          "cerca yo quiero",
          "mi vida llevar,",
          "cerca, más cerca,",
          "oh Dios de ti;"
        ]
      },
      {
        "name": "2",
        "lines": [
          "cerca de tu gracia",
          "que puede salvar,",
          "cerca de tu gracia",
          "que puede salvar."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Cerca, más cerca.",
          "tan pobre soy,",
          "nada Señor,",
          "yo te puedo ofrecer;",
          "sólo mi ser,",
          "contrito te doy,"
        ]
      },
      {
        "name": "4",
        "lines": [
          "para contigo",
          "la paz obtener,",
          "para contigo",
          "la paz obtener."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Cerca, más cerca,",
          "Señor, de ti,",
          "quiero ser tuyo",
          "dejando el pecar;",
          "goces y pompas",
          "vanas aquí,"
        ]
      },
      {
        "name": "6",
        "lines": [
          "todo, Señor,",
          "pronto quiero dejar,",
          "todo, Señor,",
          "pronto quiero dejar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Cerca, más cerca,",
          "mientras el ser",
          "aliente vida",
          "y busque tu paz,",
          "y cuando al cielo",
          "pueda ascender,",
          "ya para siempre",
          "contigo he de estar."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-438": {
    "id": "hymn-438",
    "kind": "hymn",
    "number": 438,
    "title": "Himno 438",
    "subtitle": "Los panes y los peces",
    "intro": "Aquí está un muchacho que tiene cinco panes de cebada y dos pececillos. Jn. 6.9",
    "authors": [
      "LETRA Y MÚSICA: Samuel Pascoe, arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Un niño le dio al Señor",
          "sus panes y sus peces;",
          "el Señor los multiplicó",
          "y a multitud alimentó."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Trae tus panes y tus peces",
          "al Señor, y él multiplicará.",
          "Trae tus panes y tus peces",
          "al Señor, y él multiplicará."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Si tú dejas que él",
          "tome tu corazón,",
          "el Señor te bendecirá",
          "y la vida él te dará."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-450": {
    "id": "hymn-450",
    "kind": "hymn",
    "number": 450,
    "title": "Himno 450",
    "subtitle": "Dios te bendiga",
    "intro": "Jehová te bendiga y te guarde.",
    "authors": [
      "LETRA: Epigmenio Velasco",
      "MÚSICA: Frederick Atkinson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dios te bendiga, protección te dé,",
          "sea su gracia siempre tu sostén;",
          "su ángel velando a tu redor esté,",
          "dándote abrigo por doquier.",
          "Amén. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-471": {
    "id": "hymn-471",
    "kind": "hymn",
    "number": 471,
    "title": "Himno 471",
    "subtitle": "Lléname, Señor",
    "intro": "Como el ciervo brama por las aguas, así clama por ti, oh Dios, el alma mía.",
    "authors": [
      "LETRA Y MÚSICA: Juan Salinas, arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Como el ciervo",
          "busca por las aguas,",
          "así clama mi alma por ti, Señor;",
          "día y noche yo tengo sed de ti",
          "y sólo a ti buscaré;"
        ]
      },
      {
        "name": "2",
        "lines": [
          "lléname, lléname, Señor,",
          "dame más, más de tu amor;",
          "yo tengo sed sólo de ti,",
          "lléname, Señor."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-50": {
    "id": "hymn-50",
    "kind": "hymn",
    "number": 50,
    "title": "Himno 50",
    "subtitle": "Grande es tu fidelidad",
    "intro": "Sus misericordias nuevas son cada mañana; grande es tu fidelidad. Lm. 3:22, 23.",
    "authors": [
      "LETRA: Thomas O. Chisholm, 1923, trad. Honorato Reza",
      "MÚSICA: William M. Runyan, 1923"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Oh, Dios eterno,",
          "Tu misericordia",
          "Ni una sombra",
          "De duda tendrá;",
          "Tu compasión",
          "Y bondad nunca fallan",
          "Y por los siglos",
          "El mismo serás."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "¡Oh, tu fidelidad!",
          "¡Oh, tu fidelidad!",
          "Cada momento",
          "La veo en mí;",
          "Nada me falta,",
          "Pues todo provees.",
          "¡Grande, Señor,",
          "Es tu fidelidad!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "La noche oscura,",
          "El sol y la luna",
          "Las estaciones",
          "Del año también,",
          "Unen su canto,",
          "Cual fieles criaturas,",
          "Porque eres bueno,",
          "Por siempre eres fiel."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Tú me perdonas,",
          "Me impartes el gozo,",
          "Tierno me guías",
          "Por sendas de paz;",
          "Eres mi fuerza,",
          "Mi fe, mi reposo,",
          "Y por los siglos",
          "Mi Padre serás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-511": {
    "id": "hymn-511",
    "kind": "hymn",
    "number": 511,
    "title": "Himno 511",
    "subtitle": "Dulce comunión",
    "intro": "Acá abajo los brazos eternos. Dt. 33.27",
    "authors": [
      "LETRA: Elisha A. Hoffman, trad. Pedro Grado",
      "MÚSICA: Anthony J. Showalter, 1887"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dulce comunión",
          "la que gozo ya",
          "en los brazos de mi Salvador,",
          "¡Qué gran bendición",
          "en su paz me da!",
          "¡Oh! yo siento en mí",
          "su tierno amor."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Libre, salvo",
          "(libre de penas, salvo de dudas)",
          "de cuidados y temor;",
          "libre, salvo",
          "(libre de penas, salvo de dudas)",
          "en los brazos de mi Salvador."
        ]
      },
      {
        "name": "2",
        "lines": [
          "¡Cuán dulce es vivir,",
          "cuán dulce es gozar!",
          "En los brazos de mi Salvador;",
          "quiero allí vivir,",
          "siempre allí morar,",
          "siendo objeto",
          "de su tierno amor."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Nunca temeré,",
          "ni desconfiaré",
          "en los brazos de mi Salvador;",
          "muy seguro allí",
          "siempre yo estaré",
          "de los lazos",
          "del engañador."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-79": {
    "id": "hymn-79",
    "kind": "hymn",
    "number": 79,
    "title": "Himno 79",
    "subtitle": "Con  cánticos, Señor",
    "intro": "Cantando con gracia en vuestros corazones al Señor con cánticos. Col. 3:16",
    "authors": [
      "LETRA: James J. Cummings, 1893, trad. Merrel N. Hutchinson, 1877",
      "MÚSICA: John Darwall, 1770"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Con  cánticos, Señor,",
          "Mi corazón y voz",
          "Te adoran con fervor,",
          "Oh trino, santo Dios."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "En tu mansión yo te veré",
          "Y paz eterna gozaré."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Tu mano paternal",
          "Marcó mi senda aquí;",
          "Mis pasos, cada cual,",
          "Velados son por ti."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Innumerables son",
          "Tus bienes y sin par,",
          "y por tu compasión",
          "los gozo sin cesar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Tú eres. Oh Señor,",
          "Mi sumo, todo bien;",
          "Mil lenguas tu amor",
          "Cantando siempre estén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
