{
  "hymn-159": {
    "id": "hymn-159",
    "kind": "hymn",
    "number": 159,
    "title": "Himno 159",
    "subtitle": "Cordero del Señor",
    "intro": "Fuisteis rescatados con la sangre preciosa de un cordero sin mancha. 1 Pedro  1:18-19",
    "authors": [
      "LETRA: Basada en 1 Pedro 1:18-19, trad. Aarón Zapata",
      "MUSICA: Twila Paris"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Cristo Jesús, Hijo de Dios,",
          "perfecto en santidad y amor,",
          "tú fuiste enviado a salvar",
          "a este pobre pecador."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Cordero del Señor, mi Dios,",
          "te amo a ti de corazón.",
          "Oh, lávame de mi maldad,",
          "Jesús Cordero del Señor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "En una cruz él padeció,",
          "desprecio y burlas él sufrió;",
          "como cordero él murió,",
          "el Hijo eterno del Señor."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Debí morir por pecador",
          "y tu poder me rescató,",
          "tu tierno amor me convirtió",
          "en una oveja del Señor."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-37": {
    "id": "hymn-37",
    "kind": "hymn",
    "number": 37,
    "title": "Himno 37",
    "subtitle": "Al estar aquí",
    "intro": "Que esté yo en la casa de Jehová, para contemplar la hermosura de Jehová.",
    "authors": [
      "Letra y Música: Marcos Witt. Arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Al estar en la presencia de tu divinidad,",
          "Y al contemplar la hermosura de tu santidad,",
          "Mi espíritu se alegra en tu majestad;",
          "Te adoro a ti, te adoro a ti."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Cuando veo la grandeza de tu dulce amor",
          "Y compruebo la pureza de tu corazón,",
          "Mi espíritu se alegra en tu majestad;",
          "Te doro a ti, te adoro a ti."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Y al estar aquí, delante de ti,",
          "Te adoraré;",
          "Postrado ante ti, mi corazón",
          "Te adora, oh Dios;",
          "Y siempre quiero estar",
          "para adorar",
          "y contemplar tu santidad;",
          "te adoro a ti, Señor, te adoro a ti."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-43": {
    "id": "hymn-43",
    "kind": "hymn",
    "number": 43,
    "title": "Himno 43",
    "subtitle": "¡Santo! ¡santo! ¡santo!",
    "intro": "Santo, santo, santo es el Señor Dios Todopoderoso. Ap. 4:8",
    "authors": [
      "LETRA: Reginald Heber, 1826, trad. Juan B. Cabrera",
      "MÚSICA: John B. Dykes, 1861"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "¡Santo! ¡santo! ¡santo! Señor omnipotente,",
          "siempre el labio mío loores te dará.",
          "¡Santo! ¡santo! ¡santo! te adoro reverente",
          "Dios en tres personas, bendita Trinidad."
        ]
      },
      {
        "name": "2",
        "lines": [
          "¡Santo! ¡santo! ¡santo!, En numeroso coro,",
          "Santos escogidos te adoran sin cesar",
          "De alegría llenos, y sus coronas de oro",
          "Rinden ante el trono y el cristalino mar."
        ]
      },
      {
        "name": "3",
        "lines": [
          "¡Santo! ¡santo! ¡santo! La inmensa muchedumbre",
          "De angeles que cumplen tu santa voluntad,",
          "Ante ti se postra, bañada de tu lumbre,",
          "Ante ti que has sido, que eres y serás."
        ]
      },
      {
        "name": "4",
        "lines": [
          "¡Santo! ¡santo! ¡santo! por más que estés velado,",
          "E imposible sea tu gloria contemplar;",
          "Santo tú eres solo, y nada hay a tu lado",
          "En poder perfecto, pureza y caridad."
        ]
      },
      {
        "name": "5",
        "lines": [
          "¡Santo! ¡santo! ¡santo! la gloria de tu nombre",
          "vemos en tus obras en cielo, tierra y mar;",
          "¡Santo! ¡santo! ¡santo! te adorará todo hombre,",
          "Dios en tres personas, bendita Trinidad. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-445": {
    "id": "hymn-445",
    "kind": "hymn",
    "number": 445,
    "title": "Himno 445",
    "subtitle": "Quiero darte mi ofrenda",
    "intro": "Publicad ofrendas voluntarias, pues que así lo queréis. Am. 4.5",
    "authors": [
      "LETRA Y MÚSICA: Autor desconocido, Puerto Rico, arr. Irwig Gatell"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Quiero darte mi ofrenda,",
          "adorarte con ella,",
          "aprender a servirte mejor.",
          "Dártela con cariño",
          "como lo hacen los niños",
          "que la dan de todo corazón."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Quiero ser sacrificio",
          "de tu fuego divino,",
          "mas al darte mi ofrenda,",
          "ofrendarme a mí mismo;",
          "quiero darte mi ofrenda hoy,",
          "quiero darte mi ofrenda hoy;",
          "quiero darte mi ofrenda hoy,",
          "quiero darte mi ofrenda hoy."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-453": {
    "id": "hymn-453",
    "kind": "hymn",
    "number": 453,
    "title": "Himno 453",
    "subtitle": "Después, Señor, de haber tenido aquí",
    "intro": "La exposición de tus palabras alumbra. Sal. 119.130",
    "authors": [
      "LETRA: John Ellerton, trad. Vicente Mendoza",
      "MÚSICA: Edward J. Hopkins"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Después, Señor,",
          "de haber tenido aquí",
          "de tu palabra la bendita luz,",
          "a nuestro hogar",
          "condúcenos y allí",
          "de todos cuida,",
          "¡buen Pastor Jesús!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "En nuestras almas",
          "graba con poder",
          "tu fiel palabra,",
          "cada exhortación;",
          "y que tu ley",
          "pudiendo comprender,",
          "contigo estemos en mayor unión."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Al terminar, Señor,",
          "mi vida aquí,",
          "mis ojos pueda",
          "sin temor cerrar,",
          "y en mi glorioso",
          "despertar, que en ti",
          "de paz eterna",
          "pueda disfrutar. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-50": {
    "id": "hymn-50",
    "kind": "hymn",
    "number": 50,
    "title": "Himno 50",
    "subtitle": "Grande es tu fidelidad",
    "intro": "Sus misericordias nuevas son cada mañana; grande es tu fidelidad. Lm. 3:22, 23.",
    "authors": [
      "LETRA: Thomas O. Chisholm, 1923, trad. Honorato Reza",
      "MÚSICA: William M. Runyan, 1923"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Oh, Dios eterno,",
          "Tu misericordia",
          "Ni una sombra",
          "De duda tendrá;",
          "Tu compasión",
          "Y bondad nunca fallan",
          "Y por los siglos",
          "El mismo serás."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "¡Oh, tu fidelidad!",
          "¡Oh, tu fidelidad!",
          "Cada momento",
          "La veo en mí;",
          "Nada me falta,",
          "Pues todo provees.",
          "¡Grande, Señor,",
          "Es tu fidelidad!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "La noche oscura,",
          "El sol y la luna",
          "Las estaciones",
          "Del año también,",
          "Unen su canto,",
          "Cual fieles criaturas,",
          "Porque eres bueno,",
          "Por siempre eres fiel."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Tú me perdonas,",
          "Me impartes el gozo,",
          "Tierno me guías",
          "Por sendas de paz;",
          "Eres mi fuerza,",
          "Mi fe, mi reposo,",
          "Y por los siglos",
          "Mi Padre serás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-532": {
    "id": "hymn-532",
    "kind": "hymn",
    "number": 532,
    "title": "Himno 532",
    "subtitle": "Cristo, fiel te quiero ser",
    "intro": "Cristo padeció por nosotros, dejándonos ejemplo, para que sigáis sus pisadas. 1 P. 2.21",
    "authors": [
      "LETRA Y MÚSICA: J. O. Hillyer, 1936, es traducción"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Cristo, fiel te quiero ser,",
          "dame el poder, dame el poder;",
          "yo contigo quiero andar,",
          "sin vacilar, sin vacilar."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "En tus pasos quiero seguir,",
          "cerca de ti, cerca de ti;",
          "y si encuentro pruebas aquí,",
          "dame confianza en ti."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Dame ardiente corazón",
          "lleno de amor, lleno de amor;",
          "y tu Espíritu, Señor,",
          "como guiador, como guiador."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Cada día quiero cumplir",
          "tu voluntad, tu voluntad;",
          "y servirte a ti, Señor,",
          "en humildad, en humildad."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-539": {
    "id": "hymn-539",
    "kind": "hymn",
    "number": 539,
    "title": "Himno 539",
    "subtitle": "Que mi vida entera esté",
    "intro": "La consagración de su Dios tiene sobre su cabeza. Nm. 6.7",
    "authors": [
      "LETRA: Frances R. Havergal, trad. Vicente Mendoza",
      "MÚSICA: W. G. Fischer"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Que mi vida entera esté",
          "consagrada a ti, Señor;",
          "que mis manos pueda guiar",
          "el impulso de tu amor."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Lávame en la sangre del Señor,",
          "límpiame de toda maldad;",
          "traigo a ti mi vida",
          "para ser, Señor,",
          "tuya por la eternidad."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Que mis pies tan sólo en pos",
          "de lo santo puedan ir;",
          "y que a ti, Señor, mi voz",
          "se complazca en bendecir."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Que mis labios al hablar",
          "hablen sólo de tu amor;",
          "que mis bienes ocultar",
          "no los pueda a ti, Señor."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Que mi tiempo todo esté",
          "consagrado a tu loor;",
          "y mi mente y su poder",
          "sean usados en tu honor."
        ]
      },
      {
        "name": "5",
        "lines": [
          "Toma, oh Dios, mi voluntad,",
          "y hazla tuya, nada más;",
          "toma, sí, mi corazón,",
          "y tu trono en él tendrás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
