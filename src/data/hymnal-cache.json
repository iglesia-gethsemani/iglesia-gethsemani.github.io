{
  "hymn-1": {
    "id": "hymn-1",
    "kind": "hymn",
    "number": 1,
    "title": "Himno 1",
    "subtitle": "Sólo a Dios la gloria",
    "intro": "A el sea la gloria por todos los siglos de los siglos. Ro. 11:36",
    "authors": [
      "LETRA: Rubén Hernandez Díaz, 2001",
      "MÚSICA: Obed Valenia L., 2001"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Bendito tú seas",
          "en sitios celestes,",
          "recibe los cantos",
          "de gloria y loor;",
          "bendito tú seas,",
          "te cantan las huestes",
          "que tú redimiste,",
          "¡oh gran salvador!"
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Sólo a Dios la gloria,",
          "el Padre perfecto;",
          "sólo a Dios la gloria,",
          "Jesús nuestro bien;",
          "sólo a Dios la gloria,",
          "el gran Paracleto;",
          "sólo a Dios la gloria,",
          "por siempre. Amén."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Por Cristo, el amado,",
          "tu pueblo escogido,",
          "de antaño apartado,",
          "le das un lugar;",
          "tú le haces acepto",
          "y le has bendecido",
          "en riqueza y gracia,",
          "por tu voluntad."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Por eso la gloria",
          "a tu nombre bendito",
          "rendimos fervientes",
          "¡oh Dios eternal!",
          "A ti sea la gloria,",
          "¡oh Dios infinito!",
          "A ti sea la gloria",
          "por siempre jamás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-11": {
    "id": "hymn-11",
    "kind": "hymn",
    "number": 11,
    "title": "Himno 11",
    "subtitle": "Tu palabra santa llama",
    "intro": "Tu ley esta en medio de mi corazón. Is. 40:8",
    "authors": [
      "LETRA Y MÚSICA: Alberto G. Martínez, en Rayos de esperanza, arr. L. Dominguez"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Tu palabra santa llama",
          "a todo hombre pecador,",
          "para darle siempre calma",
          "y llenarlo de tu amor;",
          "si la acepta con el alma",
          "sentirá su corazón",
          "que de veras tú le amas,",
          "¡oh, divino Salvador!"
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Cielo, estrellas, mar y tierra,",
          "todo, todo pasará;",
          "sólo tu palabra eterna",
          "por los siglos durará."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Tu palabra salvadora",
          "es verdad, es vida, es luz",
          "que ilumina a toda hora",
          "hasta donde te hallas tú.",
          "Haz que tenga yo la honra",
          "de llevar siempre tu cruz",
          "y alcanzar así la gloria,",
          "donde moras, mi Jesús."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Tu palabra es pan de Vida,",
          "es sustento espiritual;",
          "cuando llega al alma herida",
          "le da alivio, le da paz.",
          "Todo aquel que la recibe,",
          "nunca, nunca morirá,",
          "porque tú quieres que viva",
          "por toda la eternidad."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-13": {
    "id": "hymn-13",
    "kind": "hymn",
    "number": 13,
    "title": "Himno 13",
    "subtitle": "Bellas palabras de vida",
    "intro": "Moisés recibió Palabras de Vida Que darnos. Hch. 7:38",
    "authors": [
      "LETRA: Philip P. Bliss, trad. Julia Butler",
      "MUSICA: Bliss P.P. (1874)."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Oh, cantádmelas Otra Vez,",
          "Bellas Palabras de Vida;",
          "Hallo en ellas mi gozo y luz,",
          "Bellas Palabras de Vida. un",
          "Sí, de luz y Vida,",
          "son sostén y Guía."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "¡Que bellas son, Qué bellas son!",
          "Bellas Palabras de Vida.",
          "¡Que bellas son, Qué bellas son!",
          "Bellas Palabras de Vida."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Jesucristo a todos da",
          "Bellas Palabras de Vida;",
          "Oye dulce voz, mortal,",
          "Bellas Palabras de Vida.",
          "Bondadoso te salva,",
          "y al cielo te llama."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Grato el cántico sonará,",
          "Bellas Palabras de Vida;",
          "Tus Pecados perdonará,",
          "Bellas Palabras de Vida.",
          "Sí, de luz y Vida",
          "son sostén y Guía."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-2": {
    "id": "hymn-2",
    "kind": "hymn",
    "number": 2,
    "title": "Himno 2",
    "subtitle": "A Dios sea la gloria",
    "intro": "A él sea la gloria en la iglesia de Cristo Jesús. Ef. 3:21",
    "authors": [
      "LETRA Y MÚSICA: Andraé Crouch, es traducción."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "¿Cómo agradecer",
          "lo que hizo el señor por mí?",
          "Que, sin merecer,",
          "derramó su sangre carmesí;",
          "un coro de un millón de ángeles",
          "no expresará mi gratitud,",
          "pues lo que soy y un día anhelo ser,",
          "lo debo todo a él."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "A Dios sea la gloria,",
          "a Dios sea la gloria,",
          "a Dios sea la gloria",
          "por lo que hizo por mí.",
          "Con su sangre me ha salvado,",
          "su poder me ha sanado,",
          "a Dios sea la gloria",
          "por lo que hizo por mí."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Quiero vivir una vida",
          "que sea agradable sólo a él,",
          "y si ganare alguna fama,",
          "toda al Calvario llevaré."
        ]
      },
      {
        "name": "Coro para la segunda estrofa",
        "lines": [
          "Con su sangre me ha salvado",
          "su poder me ha sanado,",
          "a Dios sea la gloria",
          "por lo que hizo por mí."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-256": {
    "id": "hymn-256",
    "kind": "hymn",
    "number": 256,
    "title": "Himno 256",
    "subtitle": "Venid, cantad de gozo en plenitud",
    "intro": "Cristo Jesús me ha librado de la ley del pecado y de la muerte. Ro. 8.2",
    "authors": [
      "LETRA: Thomas M. Westrup",
      "MÚSICA: James McGranahan"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Venid, cantad",
          "de gozo en plenitud",
          "y dad loor al que su sangre dio,",
          "y luego en ella nos lavó,",
          "de nuestra lepra nos limpió,",
          "y así librónos de la esclavitud."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Él nos libró de culpabilidad",
          "y nos limpió para la eternidad;",
          "con ángeles y arcángeles",
          "nos igualó;",
          "precioso Salvador;",
          "el que por nos murió."
        ]
      },
      {
        "name": "2",
        "lines": [
          "El Dios de amor",
          "que vino acá a sufrir,",
          "llevando en sí",
          "por nos la maldición,",
          "y en vez de eterna perdición,",
          "nos proporciona salvación,",
          "que sin él nadie puede conseguir."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Honor y gloria,",
          "en todo su esplendor,",
          "serán el fin del que siga a Jesús.",
          "Que tome en pos de él su cruz",
          "y guiado siempre por su luz,",
          "reciba el sello de su Salvador."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-263": {
    "id": "hymn-263",
    "kind": "hymn",
    "number": 263,
    "title": "Himno 263",
    "subtitle": "Espíritu de Dios, llena mi vida",
    "intro": "La plenitud de Aquel que todo lo llena en todo.",
    "authors": [
      "LETRA: Autor desconocido",
      "MÚSICA: Autor desconocido, arr. Annette Harrington, Eduardo Steele"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "/Espíritu de Dios, llena mi vida,",
          "llena mi alma, llena mi ser./",
          "-",
          "/Lléname, lléname,",
          "con tu presencia lléname, lléname,",
          "con tu poder lléname, lléname",
          "con tu amor./",
          "-"
        ]
      },
      {
        "name": "2",
        "lines": [
          "Espíritu de Dios, llena mi vida,",
          "llena mi alma, llena mi ser,",
          "Espíritu de Dios."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-286": {
    "id": "hymn-286",
    "kind": "hymn",
    "number": 286,
    "title": "Himno 286",
    "subtitle": "He decidido seguir a Cristo",
    "intro": "¿Queréis acaso iros también vosotros? Jn. 6.67",
    "authors": [
      "LETRA: Autor desconocido, c. 1950. est. 2 y 3, Roberto C. Savage, est. 4 Salomón R. Mussiett",
      "MÚSICA: Melodía hindú, arr. William J. Reynolds"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "He decidido seguir a Cristo,",
          "he decidido seguir a Cristo,",
          "he decidido seguir a Cristo;",
          "no vuelvo atrás, no vuelvo atrás."
        ]
      },
      {
        "name": "2",
        "lines": [
          "El Rey de gloria me ha transformado,",
          "el Rey de gloria me ha transformado,",
          "el Rey de gloria me ha transformado;",
          "no vuelvo atrás, no vuelvo atrás."
        ]
      },
      {
        "name": "3",
        "lines": [
          "La vida vieja la he dejado,",
          "la vida vieja la he dejado,",
          "la vida vieja la he dejado;",
          "no vuelvo atrás, no vuelvo atrás."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Mi cruz levanto y sigo a Cristo,",
          "mi cruz levanto y sigo a Cristo,",
          "mi cruz levanto y sigo a Cristo;",
          "no vuelvo atrás, no vuelvo atrás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-314": {
    "id": "hymn-314",
    "kind": "hymn",
    "number": 314,
    "title": "Himno 314",
    "subtitle": "Cerca de ti, Señor",
    "intro": "¿Quién morará en tu monte santo? Sal. 15.1",
    "authors": [
      "LETRA: Sara F. Adams, trad. Thomas M. Westrup",
      "MÚSICA: Lowell Mason"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Cerca de ti, Señor,",
          "quiero morar;",
          "lo tierno de tu amor",
          "quiero gozar.",
          "Llena mi pobre ser,",
          "limpia mi corazón,",
          "hazme tu rostro ver",
          "en tu mansión."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Pasos inciertos doy,",
          "el sol se va;",
          "mas si contigo estoy",
          "no temo ya.",
          "Himnos de gratitud",
          "ferviente cantaré",
          "y fiel a ti, Jesús,",
          "siempre seré."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Día feliz veré",
          "creyendo en ti,",
          "en que habitaré",
          "cerca de ti.",
          "Mi voz alabará",
          "tu dulce nombre allí,",
          "y mi alma gozará",
          "cerca de ti."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-322": {
    "id": "hymn-322",
    "kind": "hymn",
    "number": 322,
    "title": "Himno 322",
    "subtitle": "Eres mi protector",
    "intro": "Tú eres mi refugio; me guardarás de la angustia.",
    "authors": [
      "LETRA Y MÚSICA: Michael Ledner"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Eres mi protector,",
          "llenas mi corazón",
          "con cánticos de liberación,",
          "de angustia me guardarás,",
          "confiaré en ti."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Confiaré en ti;",
          "débil soy, mas fuerte seré",
          "con poder del Señor.",
          "Eres mi protector,",
          "llenas mi corazón",
          "con cánticos de liberación,",
          "de angustia me guardarás,",
          "confiaré en ti."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-327": {
    "id": "hymn-327",
    "kind": "hymn",
    "number": 327,
    "title": "Himno 327",
    "subtitle": "Tuyo soy, Jesús",
    "intro": "Escuchad mi voz, y seré a vosotros por Dios, y me seréis por pueblo. Jer. 7.23",
    "authors": [
      "LETRA: Fanny J. Crosby, trad. Thomas E. Westrup",
      "MÚSICA: William H. Doane"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Tuyo soy, Jesús,",
          "ya escuché la voz",
          "de tu amor, hablándome aquí;",
          "mas anhelo en alas de fe subir,",
          "y más cerca estar de ti."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Aún más cerca,",
          "cerca de tu amor,",
          "llévame ¡oh, Salvador!",
          "Aún más cerca, cerca,",
          "cerca de tu amor,",
          "llévame ¡oh, buen Pastor!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "A seguirte a ti",
          "me consagro hoy,",
          "constreñido por tu amor,",
          "y mi espíritu, alma y cuerpo doy",
          "por servirte, mi Señor."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Oh, cuán pura",
          "y santa delicia es",
          "de tu comunión gozar,",
          "y contigo hablar y tu dulce voz",
          "cada día escuchar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "De tu grande amor",
          "no comprenderé",
          "cuál es la profundidad,",
          "hasta que contigo, Jesús, esté",
          "en gloriosa eternidad."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-336": {
    "id": "hymn-336",
    "kind": "hymn",
    "number": 336,
    "title": "Himno 336",
    "subtitle": "Jesús, yo he prometido",
    "intro": "Cuando a Dios haces promesa, no tardes en cumplirla. Ec. 5.4",
    "authors": [
      "LETRA: John E. Bode, trad. Juan B. Cabrera",
      "MÚSICA: A. H. Mann"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Jesús, yo he prometido",
          "servirte con amor,",
          "concédeme tu gracia,",
          "mi amigo y Salvador.",
          "No temeré la lucha",
          "si tú a mi lado estás,",
          "ni perderé el camino",
          "si tú guiando vas."
        ]
      },
      {
        "name": "2",
        "lines": [
          "El mundo está muy cerca",
          "y abunda tentación;",
          "sutil es el engaño",
          "y es necia la pasión.",
          "Ven tú, Jesús, más cerca,",
          "mostrando tu piedad,",
          "y escuda al alma mía",
          "de toda iniquidad."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Cuando mi mente vague",
          "ya incierta, ya veloz,",
          "concédeme que escuche,",
          "Jesús, tu clara voz.",
          "Levántame si caigo,",
          "inspírame también:",
          "repréndeme, si temo",
          "en todo hacer el bien."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Jesús, tú has prometido",
          "a todo aquel que va",
          "siguiendo tus pisadas,",
          "que al cielo llegará.",
          "Sostenme en el camino,",
          "y al fin, con dulce amor,",
          "trasládame a tu gloria,",
          "mi amigo y Salvador."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-337": {
    "id": "hymn-337",
    "kind": "hymn",
    "number": 337,
    "title": "Himno 337",
    "subtitle": "Haz lo que quieras, Señor, de mí",
    "intro": "Tú eres nuestro Padre, nosotros barro, obra de tus manos somos. Is. 64.8",
    "authors": [
      "LETRA: A. A. Pollard, 1907, trad. Ernesto Barocio",
      "MÚSICA: George S. Stebbins, 1907"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Haz lo que quieras,",
          "Señor, de mí,",
          "tú eres mi dueño,",
          "vivo por ti;",
          "marca la senda",
          "que seguiré,",
          "tu ley, gozoso",
          "yo acataré."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Haz lo que quieras,",
          "Señor, de mí,",
          "que tus mandatos",
          "quiero seguir;",
          "tú el alfarero,",
          "yo el barro soy,",
          "dame la forma",
          "que quieras hoy."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Haz lo que quieras,",
          "Señor, de mí,",
          "nada yo valgo",
          "lejos de ti;",
          "dame tu gracia",
          "para luchar,",
          "dame tu fuerza",
          "para triunfar."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Haz lo que quieras",
          "con mi clamor,",
          "nada yo quiero",
          "sino tu amor;",
          "pueda en mi senda",
          "mirar tu faz",
          "y en mis conflictos",
          "tener tu paz."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-349": {
    "id": "hymn-349",
    "kind": "hymn",
    "number": 349,
    "title": "Himno 349",
    "subtitle": "Contigo, Cristo, quiero andar",
    "intro": "Caminó Enoc con Dios, y le llevó Dios. Gn. 5.24",
    "authors": [
      "LETRA: W. Gladden, trad. George P. Simmonds",
      "MÚSICA: Henry P. Smith"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Contigo, Cristo, quiero andar",
          "y en tu servicio trabajar;",
          "dime el secreto de saber",
          "llevar mi vida con poder."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Enséñame cómo alcanzar",
          "al torpe y su alma rescatar;",
          "sus pies anhelo encaminar",
          "en sendas que van a tu hogar."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Enséñame paciente a ser,",
          "contigo que halle mi placer,",
          "que crezca en fuerza espiritual,",
          "y en fe que venza todo mal."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Dame esperanza para que",
          "pueda al futuro ver con fe;",
          "para poder tu paz gozar,",
          "contigo, Cristo, quiero andar."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-39": {
    "id": "hymn-39",
    "kind": "hymn",
    "number": 39,
    "title": "Himno 39",
    "subtitle": "¡Santo, santo, grande eterno Dios!",
    "intro": "Lo alabaré; Jehová ea varón de guerra; Jehová es su nombre. Exódo 15:2. 3",
    "authors": [
      "LETRA: Fanny J. Crosby 1869, trad. H. C. Bali",
      "MUSICA: William B. Bradbury, arr. Beontley O. Ackiey"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "¡Santo, santo,",
          "grande eterno Dios!",
          "con alegría hoy te alabamos,",
          "Rey de reyes, grande capitán,",
          "todopoderoso guerrero.",
          "Honor y gloria, luz y dominio",
          "tributaremos todos a ti."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "¡Santo, santo eres tú, Señor!",
          "¡Dios de las batallas, glorioso!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "Alabadle cielos, tierra y mar,",
          "toda su iglesia, sus mensajeros;",
          "alabanzas, cantos de loor",
          "hoy unidos elevaremos.",
          "Juez majestuoso y reverendo,",
          "fuego y vida eres, Señor."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Rey de siglos, solo eterno Dios,",
          "veraz y justo, incomprensible,",
          "inmortal, autor de todo bien,",
          "eres tú el anciano de días.",
          "Y para siempre entonaremos",
          "el canto eterno de redención."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-430": {
    "id": "hymn-430",
    "kind": "hymn",
    "number": 430,
    "title": "Himno 430",
    "subtitle": "A Dios  el Padre celestial",
    "intro": "Bendito sea el Dios y Padre de nuestro Señor Jescristo.",
    "authors": [
      "LETRA: Tradicional",
      "MÚSICA: Atrib. a Louis Bourgeois en Salterio de Ginebra, 1551"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "A Dios el Padre celestial,",
          "al Hijo nuestro Redentor",
          "y al eternal Consolador,",
          "unidos todos alabad. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-443": {
    "id": "hymn-443",
    "kind": "hymn",
    "number": 443,
    "title": "Himno 443",
    "subtitle": "Traigamos contentos",
    "intro": "Traerán oro e incienso, y publicarán alabanzas de Jehová. Is. 60.6",
    "authors": [
      "LETRA: Trad. Adolfo Robleto",
      "MÚSICA: Epigmenio Velasco, arr. M. B. Fletcher"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Traigamos contentos",
          "a Dios nuestra ofrenda:",
          "talentos y tiempo,",
          "dinero y salud,",
          "el cuerpo y la mente",
          "y toda influencia,",
          "también nuestra vida;",
          "todo es Jesús."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Dios es poderoso",
          "y quiere ayudarnos,",
          "a fin que tengamos",
          "la gracia de dar;",
          "y sus bendiciones",
          "no habrán de faltarnos",
          "si somos constantes",
          "en el ofrendar."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-444": {
    "id": "hymn-444",
    "kind": "hymn",
    "number": 444,
    "title": "Himno 444",
    "subtitle": "Traed los diezmos",
    "intro": "Traed todos los diezmos al alfolí y haya alimento en mi casa.",
    "authors": [
      "LETRA: Basada en Mt. 3.10",
      "MÚSICA: Edmundo Cortés G."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "/Traed los diezmos al alfolí",
          "y haya alimento en mi casa,",
          "y probadme, dice Dios./"
        ]
      },
      {
        "name": "2",
        "lines": [
          "Si no os abriré las ventanas",
          "de los cielos,",
          "derramaré sobre vosotros",
          "bendición que sobreabunde."
        ]
      },
      {
        "name": "3",
        "lines": [
          "/Traed los diezmos al alfolí,",
          "y haya alimento en mi casa,",
          "y probadme, dice Dios,/",
          "/y probadme, dice Dios./"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-445": {
    "id": "hymn-445",
    "kind": "hymn",
    "number": 445,
    "title": "Himno 445",
    "subtitle": "Quiero darte mi ofrenda",
    "intro": "Publicad ofrendas voluntarias, pues que así lo queréis. Am. 4.5",
    "authors": [
      "LETRA Y MÚSICA: Autor desconocido, Puerto Rico, arr. Irwig Gatell"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Quiero darte mi ofrenda,",
          "adorarte con ella,",
          "aprender a servirte mejor.",
          "Dártela con cariño",
          "como lo hacen los niños",
          "que la dan de todo corazón."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Quiero ser sacrificio",
          "de tu fuego divino,",
          "mas al darte mi ofrenda,",
          "ofrendarme a mí mismo;",
          "quiero darte mi ofrenda hoy,",
          "quiero darte mi ofrenda hoy;",
          "quiero darte mi ofrenda hoy,",
          "quiero darte mi ofrenda hoy."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-446": {
    "id": "hymn-446",
    "kind": "hymn",
    "number": 446,
    "title": "Himno 446",
    "subtitle": "Dale tu ofrenda al Señor",
    "intro": "Di a los hijos de Israel que tomen para mí ofrenda de su voluntad, de corazón.",
    "authors": [
      "LETRA Y MÚSICA: Autor desconocido, arr. Jean Legters"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dale tu ofrenda al Señor,",
          "dásela de corazón;",
          "que cuando el cielo reclame",
          "le respondas con amor."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Que no te quede el dolor",
          "cuando hayas ofrendado;",
          "/Dios bendice al dador alegre,",
          "multiplica lo que has dado./"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-450": {
    "id": "hymn-450",
    "kind": "hymn",
    "number": 450,
    "title": "Himno 450",
    "subtitle": "Dios te bendiga",
    "intro": "Jehová te bendiga y te guarde.",
    "authors": [
      "LETRA: Epigmenio Velasco",
      "MÚSICA: Frederick Atkinson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dios te bendiga, protección te dé,",
          "sea su gracia siempre tu sostén;",
          "su ángel velando a tu redor esté,",
          "dándote abrigo por doquier.",
          "Amén. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-579": {
    "id": "hymn-579",
    "kind": "hymn",
    "number": 579,
    "title": "Himno 579",
    "subtitle": "Pastor, te bendigo",
    "intro": "Comerás, y bendecirás a Jehová tu Dios.",
    "authors": [
      "LETRA: Amado Nervo",
      "MÚSICA: Gonzalo Báez Camargo, arr. Obed Valencia L."
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Pastor, te bendigo",
          "por lo que me das,",
          "tú siempre me das y yo te bendigo.",
          "Te sigo riendo si entre rosas vas,",
          "si vas entre cardos y zarzas te sigo.",
          "Contigo en lo menos,",
          "contigo en lo más y siempre contigo."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-664": {
    "id": "hymn-664",
    "kind": "hymn",
    "number": 664,
    "title": "Himno 664",
    "subtitle": "Salmo 23 Jehová es mi Pastor",
    "intro": "El Cordero que está en medio del trono los pastoreará. Ap. 7.17",
    "authors": [
      "LETRA: M. A. Whitaker, trad. Enrique Turrall",
      "MÚSICA: George F. Root"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Jehová es mi Pastor,",
          "me apacienta con amor,",
          "en sus pastos delicados paceré;",
          "descansando sin temor",
          "al abrigo del Señor,",
          "de las aguas de reposo beberé."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "El Señor me pastorea,",
          "nada aquí me faltará.",
          "En su brazo confiaré,",
          "junto a él caminaré,",
          "nada del amor de Dios",
          "me apartará."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Mi Pastor me guardará,",
          "siempre me confortará,",
          "por las sendas de justicia",
          "me guiará;",
          "en el tiempo del dolor",
          "me será consolador,",
          "en mi corazón su paz infundirá."
        ]
      },
      {
        "name": "3",
        "lines": [
          "¡Oh cuán fiel es mi Pastor!",
          "¡Cuán constante es su amor!",
          "Que mi copa rebosando",
          "siempre está;",
          "cuando en valle obscuro esté,",
          "mal ninguno temeré,",
          "y a la casa de mi Dios iré a morar."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-74": {
    "id": "hymn-74",
    "kind": "hymn",
    "number": 74,
    "title": "Himno 74",
    "subtitle": "¡Cuán grande es él!",
    "intro": "¡Cuán grande es tu nombre en toda la tierra! Sal. 8:9",
    "authors": [
      "LETRA: Stuart K. Hine, trad. A. W. Hotton Rives",
      "MÚSICA: Melodia Sueca, arr. Stuart K. Hine"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Señor, mí Dios,",
          "Al contemplar los cielos,",
          "El firmamento",
          "Y las estrellas mil;",
          "Al oír tu voz",
          "En los potentes truenos",
          "Y ver brillar el sol en un cenit."
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Mi corazón",
          "Entona esta canción:",
          "¡Cuán grande es él!",
          "¡Cuán grande es él!",
          "Mi corazón",
          "¡Cuán grande es él!",
          "¡Cuán grande es él!"
        ]
      },
      {
        "name": "2",
        "lines": [
          "Al recorrer",
          "los montes y los valles",
          "y ver las bellas",
          "flores al pasar,",
          "al escuchar el canto de las aves",
          "y el murmurar",
          "del claro manantial."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Cuando recuerdo",
          "Del amor divino",
          "Que desde el cielo",
          "El salvador envió,",
          "A aquel Jesús que por salvarme vino",
          "Y en una cruz",
          "Sufrió por mí y murió."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Cuando el Señor",
          "Me llame a su presencia,",
          "Al dulce hogar,",
          "Al cielo de esplendor,",
          "Le adoraré cantando",
          "La grandeza",
          "De su poder",
          "Y su infinito amor."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-82": {
    "id": "hymn-82",
    "kind": "hymn",
    "number": 82,
    "title": "Himno 82",
    "subtitle": "Alma, bendice al Señor",
    "intro": "Alabo, engrandezco y glorifico al Rey del cielo. Dn. 4:37",
    "authors": [
      "LETRA: Joachim Neander, trad. Federico Fritz Fliedner",
      "MÚSICA: En Stralsund Gesangbuch, arr. William S. Bennett"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Alma, bendice al señor,",
          "Rey potente de gloria;",
          "De sus mercedes esté",
          "Viva en ti la memoria.",
          "¡Oh despertad,",
          "Arpa y salterio¡ Entonad",
          "Himnos de honor y victoria."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Alma, bendice al señor,",
          "Que los orbes gobierna",
          "Y te conduce, paciente,",
          "Con mano paterna.",
          "Te perdonó,",
          "De todo mal te libró,",
          "Porque su gracia es eterna."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Alma , bendice al Señor",
          "De tu vida la fuente;",
          "Que te creó y en salud",
          "Te sostiene clemente.",
          "Tu defensor,",
          "En todo trance y dolor,",
          "Su diestra es omnipotente."
        ]
      },
      {
        "name": "4",
        "lines": [
          "Alma, bendice al Señor,",
          "Por su amor infinito;",
          "Con todo el pueblo de Dios,",
          "Su alabanza repito.",
          "Dios, mi salud,",
          "De todo bien plenitud,",
          "¡sea por siempre bendito!"
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
