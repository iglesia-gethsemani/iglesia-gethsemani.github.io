{
  "hymn-1": {
    "id": "hymn-1",
    "kind": "hymn",
    "number": 1,
    "title": "Himno 1",
    "subtitle": "Sólo a Dios la gloria",
    "intro": "A el sea la gloria por todos los siglos de los siglos. Ro. 11:36",
    "authors": [
      "LETRA: Rubén Hernandez Díaz, 2001",
      "MÚSICA: Obed Valenia L., 2001"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Bendito tú seas",
          "en sitios celestes,",
          "recibe los cantos",
          "de gloria y loor;",
          "bendito tú seas,",
          "te cantan las huestes",
          "que tú redimiste,",
          "¡oh gran salvador!"
        ]
      },
      {
        "name": "Coro",
        "lines": [
          "Sólo a Dios la gloria,",
          "el Padre perfecto;",
          "sólo a Dios la gloria,",
          "Jesús nuestro bien;",
          "sólo a Dios la gloria,",
          "el gran Paracleto;",
          "sólo a Dios la gloria,",
          "por siempre. Amén."
        ]
      },
      {
        "name": "2",
        "lines": [
          "Por Cristo, el amado,",
          "tu pueblo escogido,",
          "de antaño apartado,",
          "le das un lugar;",
          "tú le haces acepto",
          "y le has bendecido",
          "en riqueza y gracia,",
          "por tu voluntad."
        ]
      },
      {
        "name": "3",
        "lines": [
          "Por eso la gloria",
          "a tu nombre bendito",
          "rendimos fervientes",
          "¡oh Dios eternal!",
          "A ti sea la gloria,",
          "¡oh Dios infinito!",
          "A ti sea la gloria",
          "por siempre jamás."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  },
  "hymn-450": {
    "id": "hymn-450",
    "kind": "hymn",
    "number": 450,
    "title": "Himno 450",
    "subtitle": "Dios te bendiga",
    "intro": "Jehová te bendiga y te guarde.",
    "authors": [
      "LETRA: Epigmenio Velasco",
      "MÚSICA: Frederick Atkinson"
    ],
    "stanzas": [
      {
        "name": "1",
        "lines": [
          "Dios te bendiga, protección te dé,",
          "sea su gracia siempre tu sostén;",
          "su ángel velando a tu redor esté,",
          "dándote abrigo por doquier.",
          "Amén. Amén."
        ]
      }
    ],
    "source": "Himnario Evangélico Presbiteriano",
    "externalUrl": "https://himnariop.web.app/#"
  }
}
