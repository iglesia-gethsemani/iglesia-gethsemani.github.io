---
import PageLayout from '@/layouts/PageLayout.astro';
import ServiceOrder from '@/components/ServiceOrder.astro';
import { getCollection } from 'astro:content';
import { pathFor } from '@/utils/paths';

export async function getStaticPaths() {
  const orders = await getCollection('serviceOrders', ({ data }) => data.published);

  return orders.map((order) => ({
    params: { slug: order.id },
    props: { order },
  }));
}

const { order } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const dateLabel = dateFormatter.format(order.data.date);
const description = `${order.data.title} · ${dateLabel}, ${order.data.time} h. Orden del culto de la Iglesia Presbiteriana Reformada Gethsemaní.`;
---

<PageLayout
  title={order.data.title}
  description={description}
  canonicalPath={`/orden-del-culto/${order.id}/`}
  image={`/images/og/orden-del-culto.jpg?v=${order.id.replace(/[^a-zA-Z0-9]/g, '')}`}
  imageWidth={1200}
  imageHeight={630}
  imageAlt={`${order.data.title} · ${dateLabel} · Orden del culto Gethsemaní`}
>
  <article class="service-order-detail">
    <a class="back-link" href={pathFor('/orden-del-culto/')}>← Orden vigente y archivo</a>
    <ServiceOrder {...order.data} headingLevel="h1" />
  </article>
</PageLayout>
