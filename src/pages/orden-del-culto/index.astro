---
import PageLayout from '@/layouts/PageLayout.astro';
import ServiceOrder from '@/components/ServiceOrder.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { pathFor } from '@/utils/paths';

const orders = (await getCollection('serviceOrders'))
  .filter((order) => order.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dayKey = (date: Date) =>
  new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Mexico_City',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);

const currentDay = orders[0] ? dayKey(orders[0].data.date) : null;
const ordersForCurrentDay = currentDay
  ? orders.filter((order) => dayKey(order.data.date) === currentDay)
  : [];
const currentOrders = [...ordersForCurrentDay].sort((a, b) =>
  a.data.time.localeCompare(b.data.time),
);
const defaultOrderId =
  currentOrders.find((order) => order.data.time === '12:00')?.id ?? currentOrders[0]?.id ?? null;
const previousOrders = currentDay
  ? orders.filter((order) => dayKey(order.data.date) !== currentDay)
  : [];
const base = import.meta.env.BASE_URL;
const dateFormatter = new Intl.DateTimeFormat('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

function orderTabLabel(title: string, time: string): string {
  const normalized = title
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase();
  if (normalized.includes('escuela')) return 'Escuela Dominical';
  if (normalized.includes('vespertino')) return 'Culto Vespertino';
  if (time === '12:00' || normalized.includes('adoracion')) return 'Culto de Adoración';
  return title.replace(/[“”"].*$/, '').trim().slice(0, 28) || time;
}

const currentDateLabel = currentOrders[0]
  ? dateFormatter.format(currentOrders[0].data.date)
  : null;
const ogDescription = currentDateLabel
  ? `Orden del culto dominical del ${currentDateLabel}. Lecturas, himnos y oraciones de la Iglesia Presbiteriana Reformada Gethsemaní.`
  : 'Consulta el orden del culto dominical de la Iglesia Presbiteriana Reformada Gethsemaní.';
---

<PageLayout
  title="Orden del culto"
  description={ogDescription}
  canonicalPath="/orden-del-culto/"
  image={`/images/og/orden-del-culto.jpg?v=${currentOrders[0] ? dayKey(currentOrders[0].data.date).replaceAll('-', '') : '0'}`}
  imageWidth={1200}
  imageHeight={630}
  imageAlt={
    currentOrders[0]
      ? `Orden del culto · ${currentOrders[0].data.title} · ${currentDateLabel}`
      : 'Orden del culto dominical · Iglesia Presbiteriana Reformada Gethsemaní'
  }
>
  <header class="page-hero">
    <div>
      <p class="eyebrow">Adoremos juntos</p>
      <h1>Orden del<br /><em>culto dominical.</em></h1>
    </div>
    <p>Lecturas, himnos, oraciones y demás elementos que guían nuestra adoración congregacional cada domingo.</p>
  </header>

  <section class="service-order-page">
    <div class="service-order-main" data-service-order-switcher>
      {
        currentOrders.length > 0 ? (
          <>
            {currentOrders.length > 1 && (
              <div
                class="service-order-tabs"
                role="tablist"
                aria-label="Órdenes del culto de hoy"
              >
                {currentOrders.map((order) => {
                  const selected = order.id === defaultOrderId;
                  return (
                    <button
                      type="button"
                      class="service-order-tab"
                      role="tab"
                      id={`order-tab-${order.id}`}
                      aria-selected={selected ? 'true' : 'false'}
                      aria-controls={`order-panel-${order.id}`}
                      tabindex={selected ? 0 : -1}
                      data-order-tab={order.id}
                    >
                      <span class="service-order-tab-time">{order.data.time} h</span>
                      <span class="service-order-tab-label">
                        {orderTabLabel(order.data.title, order.data.time)}
                      </span>
                    </button>
                  );
                })}
              </div>
            )}
            {currentOrders.map((order) => {
              const selected = order.id === defaultOrderId;
              return (
                <div
                  class="service-order-panel"
                  role="tabpanel"
                  id={`order-panel-${order.id}`}
                  aria-labelledby={
                    currentOrders.length > 1 ? `order-tab-${order.id}` : undefined
                  }
                  hidden={!selected}
                  data-order-panel={order.id}
                >
                  <ServiceOrder {...order.data} />
                </div>
              );
            })}
          </>
        ) : (
          <div class="service-order-empty">
            <span class="icon-badge icon-badge--light" aria-hidden="true"><Icon name="church" /></span>
            <p class="overline blue">Próximo domingo</p>
            <h2>El nuevo orden se publicará aquí.</h2>
            <p>
              En cuanto esté listo, esta página mostrará el orden completo del culto. El mismo código QR seguirá
              funcionando cada semana.
            </p>
          </div>
        )
      }
    </div>

    <aside class="service-order-qr" aria-labelledby="qr-title">
      
      <h2 id="qr-title">Escanea para consultar el orden</h2>
      <img
        src={`${base}images/qr-orden-del-culto.png`}
        alt="Código QR para abrir el orden del culto dominical"
        width="1200"
        height="1200"
      />
      <p>Este código siempre abrirá el orden vigente. Puedes imprimirlo y colocarlo en la entrada o en las bancas.</p>
      <a class="button button-blue" href={`${base}images/qr-orden-del-culto.png`} download="QR-orden-del-culto-Gethsemani.png">
        Descargar código QR
      </a>
    </aside>
  </section>

  {
    previousOrders.length > 0 && (
      <section class="service-order-archive section" aria-labelledby="order-archive-title">
        <div class="section-heading">
          <p class="overline blue">Archivo</p>
          <h2 id="order-archive-title">Órdenes anteriores</h2>
        </div>
        <div class="service-order-archive-list">
          {previousOrders.map((order) => (
            <a href={pathFor(`/orden-del-culto/${order.id}/`)}>
              <time datetime={order.data.date.toISOString().slice(0, 10)}>
                {dateFormatter.format(order.data.date)}
              </time>
              <strong>{order.data.title}</strong>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</PageLayout>
