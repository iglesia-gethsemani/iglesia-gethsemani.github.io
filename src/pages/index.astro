---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/Icon.astro';
import DailyDevotion from '@/components/DailyDevotion.astro';
import { getCollection } from 'astro:content';
import { pathFor } from '@/utils/paths';
import { getYouTubeThumbnail } from '@/utils/youtube';
import { sermonImageWebpSrcset } from '@/utils/sermon-image';

const base = import.meta.env.BASE_URL;
const featuredVideoUrl = 'https://www.youtube.com/watch?v=wFzQMnFORgU';
const featuredThumbnail = getYouTubeThumbnail(featuredVideoUrl);
const latestReflection = (await getCollection('reflections'))
  .filter((reflection) => reflection.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const featuredService = (await getCollection('serviceOrders'))
  .filter(
    (order) =>
      order.data.published &&
      order.data.time === '12:00' &&
      Boolean(order.data.sermonImage),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const featuredServiceDate = featuredService
  ? new Intl.DateTimeFormat('es-MX', {
      timeZone: 'America/Mexico_City',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(featuredService.data.date)
  : null;
const featuredServiceImage = featuredService?.data.sermonImage
  ? featuredService.data.sermonImage.startsWith('http')
    ? featuredService.data.sermonImage
    : `${base}${featuredService.data.sermonImage.replace(/^\//, '')}`
  : null;
const featuredServiceWebpSrc = sermonImageWebpSrcset(
  featuredService?.data.sermonImage,
  base,
);
const featuredServiceWebp = featuredServiceWebpSrc
  ? { srcset: featuredServiceWebpSrc }
  : null;
---

<PageLayout
  title="Iglesia Presbiteriana Reformada | Gethsemaní"
  description="Iglesia Presbiteriana Reformada Gethsemaní en Coyoacán. Una iglesia confesional centrada en Cristo, la Palabra y la comunidad."
  canonicalPath="/"
>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="overline">Iglesia Presbiteriana Reformada</p>
      <h1>Gethsemaní</h1>
      <p class="hero-summary">
        Congregación confesional en Coyoacán, dedicada a la adoración solemne, la predicación de las Escrituras
        y la vida en comunidad bajo la soberanía de Jesucristo.
      </p>
      <div class="hero-buttons">
        <a class="button button-white" href={pathFor('/contacto/')}>Planea tu visita <Icon name="arrow" /></a>
        <a class="button button-ghost" href={pathFor('/sermones/')}>Ver sermones</a>
      </div>
    </div>
    <figure class="home-hero-image">
      <picture>
        <source
          media="(min-width: 901px)"
          type="image/webp"
          srcset={`${base}images/optimized/templo-gethsemani-1024.webp 1024w, ${base}images/optimized/templo-gethsemani-1600.webp 1600w`}
          sizes="50vw"
        />
        <source
          media="(max-width: 900px)"
          type="image/webp"
          srcset={`${base}images/optimized/templo-gethsemani-480.webp 480w, ${base}images/optimized/templo-gethsemani-640.webp 640w, ${base}images/optimized/templo-gethsemani-960.webp 960w`}
          sizes="100vw"
        />
        <img
          src={`${base}images/optimized/templo-gethsemani-640.jpg`}
          alt="Templo de la Iglesia Presbiteriana Reformada Gethsemaní"
          width="640"
          height="853"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </section>

  <section class="intro-band">
    <p>Fundada en la fe reformada · Predicando a Cristo en Coyoacán</p>
  </section>

  {
    featuredService && featuredServiceImage && (
      <section class="sermon-invitation" aria-labelledby="sermon-invitation-title">
        <figure class="sermon-invitation-media">
          <picture>
            {featuredServiceWebp && (
              <source
                type="image/webp"
                srcset={featuredServiceWebp.srcset}
                sizes="(max-width: 900px) 100vw, min(1232px, 100vw)"
              />
            )}
            <img
              src={featuredServiceImage}
              alt={featuredService.data.sermonImageAlt ?? `Miniatura de la predicación ${featuredService.data.sermonTitle ?? ''}`.trim()}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
        <div class="sermon-invitation-copy">
          <div class="sermon-invitation-meta">
            <p class="overline blue">Este domingo</p>
            <time datetime={featuredService.data.date.toISOString()}>
              {featuredServiceDate} · {featuredService.data.time} h
            </time>
            <h2 id="sermon-invitation-title" class="sr-only">
              {featuredService.data.sermonTitle || featuredService.data.title}
            </h2>
            {featuredService.data.preacher && (
              <p class="sermon-invitation-preacher">
                <small>Predica</small>
                <strong>{featuredService.data.preacher}</strong>
              </p>
            )}
          </div>
          <a class="button button-blue" href={pathFor('/orden-del-culto/')}>
            Consultar el orden del culto <Icon name="arrow" />
          </a>
        </div>
      </section>
    )
  }

  {
    latestReflection && (
      <section class="latest-reflection-section" aria-labelledby="latest-reflection-title">
        <div class="latest-reflection-heading">
          <p class="overline blue">Reflexión semanal</p>
          <h2 id="latest-reflection-title">{latestReflection.data.title}</h2>
          {latestReflection.data.author && <p class="latest-reflection-author">Por {latestReflection.data.author}</p>}
        </div>
        <div class="latest-reflection-copy">
          {latestReflection.data.passage && <blockquote>{latestReflection.data.passage}</blockquote>}
          {latestReflection.data.description && <p>{latestReflection.data.description}</p>}
          <a class="arrow-link" href={pathFor(`/reflexiones/${latestReflection.id}/`)}>
            Leer la reflexión completa <Icon name="arrow" />
          </a>
        </div>
      </section>
    )
  }

  <DailyDevotion />

  <section class="content-section welcome-grid">
    <div>
      <p class="overline blue">Nuestra congregación</p>
      <h2>Doctrina bíblica,<br />adoración solemne<br />y vida congregacional.</h2>
    </div>
    <div>
      <p class="large-copy">
        Somos una iglesia presbiteriana reformada que confiesa las Escrituras como regla de fe y práctica,
        y que vive su fe en el culto público, la instrucción y el servicio mutuo.
      </p>
      <a class="arrow-link" href={pathFor('/nosotros/')}>Nuestra historia <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="belief-preview">
    <div class="belief-preview-head">
      <div>
        <p class="overline">Lo que creemos</p>
        <h2>Una fe bíblica, histórica y reformada.</h2>
      </div>
      <a class="button button-blue" href={pathFor('/lo-que-creemos/')}>
        Ver confesiones <Icon name="arrow" />
      </a>
    </div>
    <div class="belief-pillars belief-pillars--five">
      <article>
        <span class="icon-badge" aria-hidden="true"><Icon name="scripture" /></span>
        <h3>Sola Scriptura</h3>
        <p>Solo la Escritura</p>
      </article>
      <article>
        <span class="icon-badge" aria-hidden="true"><Icon name="gift" /></span>
        <h3>Sola Gratia</h3>
        <p>Solo por gracia</p>
      </article>
      <article>
        <span class="icon-badge" aria-hidden="true"><Icon name="faith" /></span>
        <h3>Sola Fide</h3>
        <p>Solo por la fe</p>
      </article>
      <article>
        <span class="icon-badge" aria-hidden="true"><Icon name="ichthus" /></span>
        <h3>Solus Christus</h3>
        <p>Solo Cristo</p>
      </article>
      <article>
        <span class="icon-badge" aria-hidden="true"><Icon name="crown" /></span>
        <h3>Soli Deo Gloria</h3>
        <p>Solo a Dios la gloria</p>
      </article>
    </div>
  </section>

  <section class="media-section">
    <div>
      <p class="overline blue">Ministerio de la Palabra</p>
      <h2>Sermones, reflexiones<br />y recursos.</h2>
    </div>
    <div class="media-cards">
      <a href={pathFor('/sermones/')}>
        <span class="icon-badge" aria-hidden="true"><Icon name="play" /></span>
        <div><small>Escucha</small><strong>Sermones recientes</strong></div>
        <b aria-hidden="true">→</b>
      </a>
      <a href={pathFor('/reflexiones/')}>
        <span class="icon-badge" aria-hidden="true"><Icon name="spark" /></span>
        <div><small>Lee</small><strong>Reflexiones bíblicas</strong></div>
        <b aria-hidden="true">→</b>
      </a>
      <a href={pathFor('/orden-del-culto/')}>
        <span class="icon-badge" aria-hidden="true"><Icon name="church" /></span>
        <div><small>Este domingo</small><strong>Orden del culto</strong></div>
        <b aria-hidden="true">→</b>
      </a>
      <a href={pathFor('/recursos/')}>
        <span class="icon-badge" aria-hidden="true"><Icon name="scroll" /></span>
        <div><small>Biblioteca</small><strong>Recursos confesionales</strong></div>
        <b aria-hidden="true">→</b>
      </a>
    </div>
  </section>

  <section class="channel-section">
    <div class="channel-copy">
      <p class="overline">Canal oficial</p>
      <h2>Predicación para la semana.</h2>
      <p>Sermones, cultos y estudios publicados por la congregación.</p>
      <a class="button button-white" href={pathFor('/sermones/')}>
        Ver todos los videos <Icon name="arrow" />
      </a>
    </div>
    <a class="channel-feature" href={featuredVideoUrl} target="_blank" rel="noopener">
      <img
        src={featuredThumbnail}
        alt="La murmuración, estudio bíblico del 19 de julio de 2026"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <span class="play-icon" aria-hidden="true"><Icon name="play" /></span>
      <div>
        <small>Estudio bíblico reciente</small>
        <strong>La murmuración</strong>
        <p>19 de julio de 2026 · 18:00 horas</p>
      </div>
    </a>
  </section>

  <section class="visit-cta">
    <div class="visit-cta-media" aria-hidden="true">
      <picture>
        <source
          media="(min-width: 901px)"
          type="image/webp"
          srcset={`${base}images/optimized/templo-gethsemani-1024.webp 1024w, ${base}images/optimized/templo-gethsemani-1600.webp 1600w`}
          sizes="50vw"
        />
        <source
          media="(max-width: 900px)"
          type="image/webp"
          srcset={`${base}images/optimized/templo-gethsemani-480.webp 480w, ${base}images/optimized/templo-gethsemani-640.webp 640w, ${base}images/optimized/templo-gethsemani-960.webp 960w`}
          sizes="100vw"
        />
        <img
          src={`${base}images/optimized/templo-gethsemani-640.jpg`}
          alt=""
          width="640"
          height="853"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="visit-cta-copy">
      <p class="overline">Horario dominical</p>
      <h2>Te esperamos este domingo.</h2>
      <p>
        Cuauhtémoc 117, esquina con Allende, Colonia Del Carmen, Coyoacán, Ciudad de México.
      </p>
      <ul class="visit-cta-times">
        <li><strong>9:30</strong><span>Aposento Alto</span></li>
        <li><strong>10:30</strong><span>Escuela Bíblica Dominical</span></li>
        <li><strong>12:00</strong><span>Culto de adoración</span></li>
        <li><strong>18:00</strong><span>Culto familiar</span></li>
      </ul>
      <div class="visit-cta-actions">
        <a class="button button-white" href={pathFor('/contacto/')}>
          Cómo llegar <Icon name="map" />
        </a>
        <a class="button button-ghost" href="tel:+525555543467">
          Llamar <Icon name="phone" />
        </a>
      </div>
    </div>
  </section>
</PageLayout>
