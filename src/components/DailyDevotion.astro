---
import Icon from '@/components/Icon.astro';
import { pathFor } from '@/utils/paths';
import {
  bibleGatewayUrl,
  formatDateMexico,
  getDayOfYearMexico,
} from '@/utils/calendar';
import { getVerseForDay } from '@/data/verse-of-the-day';
import {
  formatPassagesLabel,
  getReadingForDay,
  passageUrl,
} from '@/data/reading-plan';
import { assetVersion } from '@/utils/assets';

const dayOfYear = getDayOfYearMexico();
const verse = getVerseForDay(dayOfYear);
const reading = getReadingForDay(dayOfYear);
const dateLabel = formatDateMexico();
const verseLink = bibleGatewayUrl(verse.reference);
const readingLabel = formatPassagesLabel(reading.passages);
const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://iglesia-gethsemani.github.io';
const planUrl = new URL('plan-de-lecturas/', `${site}${base}`).href;
const logoSrc = `${base}images/optimized/logo-gethsemani-240.webp`;
const fallbackBgSrc = `${base}images/optimized/templo-gethsemani-640.jpg`;
const catalogUrl = `${base}data/daily-devotion.json?v=${assetVersion}`;
const themesUrl = `${base}data/share-themes.json?v=${assetVersion}`;

const boot = { catalogUrl, themesUrl, planUrl, logoSrc, fallbackBgSrc };
---

<section class="daily-devotion" aria-labelledby="daily-devotion-title" data-daily-devotion>
  <div class="daily-devotion-stage">
    <header class="daily-devotion-head">
      <p class="overline">Cada día en la Palabra</p>
      <div class="daily-devotion-head-meta">
        <time data-devotion-date>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span data-verse-version>{verse.version}</span>
      </div>
    </header>

    <div class="daily-verse-stage">
      <p class="daily-verse-kicker" id="daily-devotion-title">Versículo del día</p>
      <blockquote data-verse-text>“{verse.text}”</blockquote>
      <div class="daily-verse-actions">
        <a
          class="daily-verse-ref"
          data-verse-ref
          href={verseLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          {verse.reference}
        </a>
        <button
          type="button"
          class="daily-share-toggle"
          data-share-toggle
          aria-expanded="false"
          aria-controls="daily-share-panel"
        >
          <Icon name="share" />
          <span>Compartir</span>
        </button>
      </div>
    </div>
  </div>

  <div class="daily-reading-bar">
    <div class="daily-reading-bar-copy">
      <p class="daily-panel-label">Lectura de hoy</p>
      <p class="daily-reading-day" data-reading-day>
        Día <strong data-reading-day-num>{reading.day}</strong>
        <span>del plan anual</span>
      </p>
      <p class="sr-only" data-reading-summary>{readingLabel}</p>
    </div>

    <ul class="daily-reading-list" data-reading-list>
      {
        reading.passages.map((passage) => (
          <li>
            <a href={passageUrl(passage)} target="_blank" rel="noopener noreferrer">
              {passage.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="daily-reading-cta" href={pathFor('/plan-de-lecturas/')}>
      Plan completo <Icon name="arrow" />
    </a>
  </div>

  <div class="daily-share" id="daily-share-panel" data-daily-share hidden>
    <div class="daily-share-preview">
      <canvas
        data-share-canvas
        width="1080"
        height="1350"
        aria-label="Vista previa de la imagen para compartir"
      ></canvas>
    </div>

    <div class="daily-share-copy">
      <p class="daily-panel-label">Compartir</p>
      <h3>Versículo y lectura del día</h3>
      <p>Copia el texto o descarga la imagen. Puedes probar distintos estilos visuales.</p>
      <div class="daily-share-styles" role="group" aria-label="Estilo de la imagen">
        <button type="button" class="daily-share-style" data-share-style-prev>← Anterior</button>
        <span class="daily-share-style-label" data-share-style-label>Estilo 1</span>
        <button type="button" class="daily-share-style" data-share-style-next>Siguiente →</button>
      </div>
      <div class="daily-share-actions">
        <button type="button" class="daily-share-btn daily-share-btn--primary" data-copy-devotion>
          <Icon name="link" />
          <span data-copy-devotion-label>Copiar texto</span>
        </button>
        <button type="button" class="daily-share-btn" data-download-devotion>
          <Icon name="share" />
          <span>Descargar imagen</span>
        </button>
        <button type="button" class="daily-share-btn" data-copy-devotion-image hidden>
          <Icon name="link" />
          <span data-copy-image-label>Copiar imagen</span>
        </button>
      </div>
      <p class="daily-share-feedback" data-share-devotion-feedback hidden></p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ boot }}>
  function getDayOfYearMexico(date = new Date()) {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Mexico_City',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
    }).formatToParts(date);
    const year = Number(parts.find((part) => part.type === 'year')?.value);
    const month = Number(parts.find((part) => part.type === 'month')?.value);
    const day = Number(parts.find((part) => part.type === 'day')?.value);
    const start = Date.UTC(year, 0, 0);
    const current = Date.UTC(year, month - 1, day);
    return Math.floor((current - start) / 86_400_000);
  }

  function formatDateMexico(date = new Date()) {
    return new Intl.DateTimeFormat('es-MX', {
      timeZone: 'America/Mexico_City',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(date);
  }

  function bibleGatewayUrl(reference) {
    return `https://www.biblegateway.com/passage/?search=${encodeURIComponent(reference)}&version=RVR1960`;
  }

  function pick(list, dayOfYear) {
    if (!list?.length) return null;
    return list[((dayOfYear - 1) % list.length + list.length) % list.length];
  }

  function wrapLines(ctx, text, maxWidth) {
    const words = text.split(/\s+/);
    const lines = [];
    let line = '';
    for (const word of words) {
      const next = line ? `${line} ${word}` : word;
      if (ctx.measureText(next).width > maxWidth && line) {
        lines.push(line);
        line = word;
      } else {
        line = next;
      }
    }
    if (line) lines.push(line);
    return lines;
  }

  function loadImage(src, { cors = false } = {}) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.decoding = 'async';
      if (cors) img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });
  }

  function hexToRgba(hex, alpha) {
    const value = hex.replace('#', '');
    const full = value.length === 3 ? value.split('').map((c) => c + c).join('') : value;
    const num = Number.parseInt(full, 16);
    return `rgba(${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}, ${alpha})`;
  }

  function coverImage(ctx, img, x, y, w, h) {
    const scale = Math.max(w / img.width, h / img.height);
    const bw = img.width * scale;
    const bh = img.height * scale;
    ctx.drawImage(img, x + (w - bw) / 2, y + (h - bh) / 2, bw, bh);
  }

  const cardLayouts = [
    {
      id: 'centered-quote',
      label: 'Cita centrada',
      size: [1080, 1080],
      align: 'center',
      face: 'italic 500 {size}px "Source Serif 4", Georgia, serif',
      kicker: '700 18px Manrope, Arial, sans-serif',
      meta: '500 18px Manrope, Arial, sans-serif',
      overlay: 0.62,
    },
    {
      id: 'bold-serif',
      label: 'Serif editorial',
      size: [1080, 1350],
      align: 'left',
      face: '600 {size}px "Source Serif 4", Georgia, serif',
      kicker: '800 17px Manrope, Arial, sans-serif',
      meta: '500 17px Manrope, Arial, sans-serif',
      overlay: 0.64,
    },
    {
      id: 'modern-sans',
      label: 'Sans moderna',
      size: [1080, 1080],
      align: 'left',
      face: '500 {size}px Manrope, Arial, sans-serif',
      kicker: '800 16px Manrope, Arial, sans-serif',
      meta: '500 16px Manrope, Arial, sans-serif',
      overlay: 0.6,
    },
    {
      id: 'classic-frame',
      label: 'Marco clásico',
      size: [1080, 1350],
      align: 'center',
      face: 'italic 600 {size}px Georgia, "Times New Roman", serif',
      kicker: '700 16px Manrope, Arial, sans-serif',
      meta: '500 16px Manrope, Arial, sans-serif',
      overlay: 0.66,
    },
    {
      id: 'story-tall',
      label: 'Historia vertical',
      size: [1080, 1920],
      align: 'center',
      face: 'italic 500 {size}px "Source Serif 4", Georgia, serif',
      kicker: '800 18px Manrope, Arial, sans-serif',
      meta: '500 18px Manrope, Arial, sans-serif',
      overlay: 0.68,
    },
    {
      id: 'minimal-light',
      label: 'Minimal clara',
      size: [1080, 1080],
      align: 'left',
      face: '600 {size}px "Source Serif 4", Georgia, serif',
      kicker: '800 15px Manrope, Arial, sans-serif',
      meta: '500 16px Manrope, Arial, sans-serif',
      overlay: 0.22,
      light: true,
    },
    {
      id: 'wide-banner',
      label: 'Banner horizontal',
      size: [1350, 1080],
      align: 'left',
      face: '600 {size}px "Source Serif 4", Georgia, serif',
      kicker: '800 16px Manrope, Arial, sans-serif',
      meta: '500 16px Manrope, Arial, sans-serif',
      overlay: 0.58,
    },
    {
      id: 'compact-card',
      label: 'Tarjeta compacta',
      size: [1080, 1080],
      align: 'center',
      face: '600 {size}px Georgia, "Times New Roman", serif',
      kicker: '800 15px Manrope, Arial, sans-serif',
      meta: '500 15px Manrope, Arial, sans-serif',
      overlay: 0.72,
    },
    {
      id: 'bottom-anchor',
      label: 'Ancla inferior',
      size: [1080, 1350],
      align: 'left',
      face: 'italic 500 {size}px "Source Serif 4", Georgia, serif',
      kicker: '800 16px Manrope, Arial, sans-serif',
      meta: '500 16px Manrope, Arial, sans-serif',
      overlay: 0.7,
      anchor: 'bottom',
    },
    {
      id: 'soft-wash',
      label: 'Lavado suave',
      size: [1080, 1080],
      align: 'center',
      face: '500 {size}px "Source Serif 4", Georgia, serif',
      kicker: '700 15px Manrope, Arial, sans-serif',
      meta: '500 15px Manrope, Arial, sans-serif',
      overlay: 0.48,
    },
  ];

  const root = document.querySelector('[data-daily-devotion]');
  if (!root) return;

  const dayOfYear = getDayOfYearMexico();
  const dateLabel = formatDateMexico();
  let verse = null;
  let reading = null;
  let theme = null;
  let catalog = null;
  let layoutIndex = (dayOfYear - 1) % cardLayouts.length;
  let shareText = '';
  let cardReady = false;

  const dateEl = root.querySelector('[data-devotion-date]');
  const textEl = root.querySelector('[data-verse-text]');
  const refEl = root.querySelector('[data-verse-ref]');
  const versionEl = root.querySelector('[data-verse-version]');
  const dayNumEl = root.querySelector('[data-reading-day-num]');
  const listEl = root.querySelector('[data-reading-list]');
  const summaryEl = root.querySelector('[data-reading-summary]');
  const sharePanel = root.querySelector('[data-daily-share]');
  const shareToggle = root.querySelector('[data-share-toggle]');
  const canvas = root.querySelector('[data-share-canvas]');
  const feedback = root.querySelector('[data-share-devotion-feedback]');
  const copyBtn = root.querySelector('[data-copy-devotion]');
  const copyLabel = root.querySelector('[data-copy-devotion-label]');
  const downloadBtn = root.querySelector('[data-download-devotion]');
  const copyImageBtn = root.querySelector('[data-copy-devotion-image]');
  const copyImageLabel = root.querySelector('[data-copy-image-label]');
  const stylePrev = root.querySelector('[data-share-style-prev]');
  const styleNext = root.querySelector('[data-share-style-next]');
  const styleLabel = root.querySelector('[data-share-style-label]');

  function updateStyleLabel() {
    const layout = cardLayouts[layoutIndex];
    if (styleLabel) styleLabel.textContent = `${layout.label} · ${layoutIndex + 1}/${cardLayouts.length}`;
  }

  function renderDevotion() {
    if (!verse || !reading) return;
    if (dateEl) dateEl.textContent = dateLabel;
    if (textEl) textEl.textContent = `“${verse.text}”`;
    if (refEl instanceof HTMLAnchorElement) {
      refEl.textContent = verse.reference;
      refEl.href = bibleGatewayUrl(verse.reference);
    }
    if (versionEl) versionEl.textContent = verse.version;
    if (dayNumEl) dayNumEl.textContent = String(reading.day);
    if (summaryEl) summaryEl.textContent = reading.passages.map((p) => p.label).join(' · ');
    if (listEl) {
      listEl.replaceChildren(
        ...reading.passages.map((passage) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = bibleGatewayUrl(passage.gatewayRef || passage.label);
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = passage.label;
          li.append(a);
          return li;
        }),
      );
    }
    shareText = [
      'Versículo del día',
      dateLabel.replace(/^\w/, (c) => c.toUpperCase()),
      '',
      `“${verse.text}”`,
      `— ${verse.reference} (${verse.version})`,
      '',
      `Lectura de hoy · Día ${reading.day}`,
      ...reading.passages.map((passage) => `• ${passage.label}`),
      '',
      'Iglesia Presbiteriana Reformada Gethsemaní',
      boot.planUrl,
    ].join('\n');
    updateStyleLabel();
  }

  function normalizeReading(entry) {
    if (!entry) return null;
    const passages = (entry.passages || []).map((passage) =>
      typeof passage === 'string'
        ? { label: passage, gatewayRef: passage }
        : { label: passage.label, gatewayRef: passage.gatewayRef || passage.label },
    );
    return { day: entry.day, passages };
  }

  async function loadCatalog() {
    const response = await fetch(boot.catalogUrl, { credentials: 'same-origin' });
    if (!response.ok) throw new Error(`catalog ${response.status}`);
    catalog = await response.json();
    verse = pick(catalog.verses, dayOfYear);
    const planDay = Math.min(Math.max(dayOfYear, 1), catalog.plan.length);
    reading = normalizeReading(catalog.plan[planDay - 1]);
    renderDevotion();
  }

  async function loadThemes() {
    if (theme) return theme;
    const response = await fetch(boot.themesUrl, { credentials: 'same-origin' });
    if (!response.ok) throw new Error(`themes ${response.status}`);
    const data = await response.json();
    theme = pick(data.themes, dayOfYear);
    return theme;
  }

  function showFeedback(message) {
    if (!(feedback instanceof HTMLElement)) return;
    feedback.hidden = false;
    feedback.textContent = message;
  }

  async function drawShareCard() {
    if (!(canvas instanceof HTMLCanvasElement) || !verse || !reading || !theme) return null;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;

    const layout = cardLayouts[layoutIndex];
    const { palette } = theme;
    const [W, H] = layout.size;
    const light = Boolean(layout.light);
    canvas.width = W;
    canvas.height = H;
    canvas.style.aspectRatio = `${W} / ${H}`;
    ctx.clearRect(0, 0, W, H);

    let photo = null;
    try {
      photo = await loadImage(theme.imageUrl, { cors: true });
    } catch {
      try {
        photo = await loadImage(boot.fallbackBgSrc);
      } catch {
        photo = null;
      }
    }

    if (photo) coverImage(ctx, photo, 0, 0, W, H);
    else {
      const gradient = ctx.createLinearGradient(0, 0, W, H);
      gradient.addColorStop(0, light ? '#f7f4ec' : palette.deep);
      gradient.addColorStop(1, light ? '#ebe4d6' : palette.mid);
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, W, H);
    }

    ctx.fillStyle = light ? hexToRgba('#f7f4ec', layout.overlay) : hexToRgba(palette.deep, layout.overlay);
    ctx.fillRect(0, 0, W, H);
    if (!light) {
      const wash = ctx.createRadialGradient(W / 2, H / 2, H * 0.1, W / 2, H / 2, H * 0.75);
      wash.addColorStop(0, hexToRgba(palette.mid, 0.15));
      wash.addColorStop(1, hexToRgba(palette.deep, 0.55));
      ctx.fillStyle = wash;
      ctx.fillRect(0, 0, W, H);
    }

    const ink = light ? '#252a27' : palette.ink;
    const muted = light ? '#686d69' : palette.muted;
    const accent = light ? '#835f34' : palette.accent;

    const padX = layout.align === 'center' ? 90 : 72;
    const maxW = W - padX * 2;
    const verseText = `“${verse.text}”`;
    const dateText = dateLabel.replace(/^\w/, (c) => c.toUpperCase());
    const readingText = `Día ${reading.day}  ·  ${reading.passages.map((p) => p.label).join('  ·  ')}`;

    const targetVerseH = H * (H > 1600 ? 0.4 : H > 1200 ? 0.46 : 0.42);
    let fontSize = H > 1600 ? 86 : 78;
    let verseLines = [];
    let lineH = 0;
    while (fontSize >= 28) {
      ctx.font = layout.face.replace('{size}', String(fontSize));
      verseLines = wrapLines(ctx, verseText, maxW);
      lineH = Math.round(fontSize * 1.22);
      if (verseLines.length * lineH <= targetVerseH && verseLines.length <= 10) break;
      fontSize -= 2;
    }
    if (verseLines.length > 10) {
      verseLines = verseLines.slice(0, 10);
      verseLines[9] = verseLines[9].replace(/…?$/, '') + '…';
    }
    const verseBlockH = verseLines.length * lineH;

    const frameInset = 40;
    const footerPad = 28;
    const logoH = 64;
    let logo = null;
    try {
      logo = await loadImage(boot.logoSrc);
    } catch {
      logo = null;
    }
    const logoW = logo ? (logo.width / logo.height) * logoH : 0;
    const footerBlockH = Math.max(logoH, 58) + 8;
    const footerTop = H - frameInset - footerPad - footerBlockH;

    ctx.font = layout.kicker;
    const kickerH = 22;
    ctx.font = layout.meta;
    const metaH = 20;
    const refH = 28;
    const accentLineH = 20;
    const readingLines = (() => {
      ctx.font = layout.meta;
      return wrapLines(ctx, readingText, maxW).slice(0, 2);
    })();
    const readingH = readingLines.length * 26;
    const gap = 22;
    const stackH =
      accentLineH + kickerH + 14 + metaH + gap * 1.4 + verseBlockH + gap + refH + gap + readingH;

    const contentTop = frameInset + 48;
    const contentBottom = footerTop - 24;
    const available = contentBottom - contentTop;
    let y =
      layout.anchor === 'bottom'
        ? Math.max(contentTop, contentBottom - stackH)
        : contentTop + Math.max(0, (available - stackH) / 2);
    const tx = layout.align === 'center' ? W / 2 : padX;
    ctx.textAlign = layout.align === 'center' ? 'center' : 'left';

    ctx.strokeStyle = hexToRgba(accent, light ? 0.55 : 0.35);
    ctx.lineWidth = 1.5;
    ctx.strokeRect(frameInset, frameInset, W - frameInset * 2, H - frameInset * 2);

    const lineW = 48;
    ctx.fillStyle = accent;
    if (layout.align === 'center') ctx.fillRect(W / 2 - lineW / 2, y, lineW, 2);
    else ctx.fillRect(padX, y, lineW, 2);
    y += accentLineH;

    ctx.fillStyle = accent;
    ctx.font = layout.kicker;
    ctx.fillText('VERSÍCULO DEL DÍA', tx, y + kickerH);
    y += kickerH + 14;

    ctx.fillStyle = muted;
    ctx.font = layout.meta;
    ctx.fillText(dateText, tx, y + metaH);
    y += metaH + gap * 1.4;

    ctx.fillStyle = ink;
    ctx.font = layout.face.replace('{size}', String(fontSize));
    for (const line of verseLines) {
      ctx.fillText(line, tx, y + fontSize * 0.85);
      y += lineH;
    }
    y += gap;

    ctx.fillStyle = accent;
    ctx.font = `700 ${Math.max(20, Math.round(fontSize * 0.38))}px Manrope, Arial, sans-serif`;
    ctx.fillText(`${verse.reference}  ·  ${verse.version}`, tx, y + refH * 0.7);
    y += refH + gap;

    ctx.fillStyle = muted;
    ctx.font = layout.meta;
    for (const line of readingLines) {
      ctx.fillText(line, tx, y + 18);
      y += 26;
    }

    ctx.textAlign = 'left';
    const signatureX = padX;
    const signatureY = footerTop;
    if (logo) ctx.drawImage(logo, signatureX, signatureY, logoW, logoH);
    const textX = signatureX + (logo ? logoW + 18 : 0);
    const textMidY = signatureY + logoH / 2;
    ctx.fillStyle = ink;
    ctx.font = '600 26px "Source Serif 4", Georgia, serif';
    ctx.fillText('Gethsemaní', textX, textMidY - 6);
    ctx.fillStyle = muted;
    ctx.font = '600 15px Manrope, Arial, sans-serif';
    ctx.fillText('Iglesia Presbiteriana Reformada', textX, textMidY + 18);

    return canvas;
  }

  async function canvasToBlob(target) {
    return new Promise((resolve) => {
      target.toBlob((blob) => resolve(blob), 'image/png');
    });
  }

  async function ensureShareCard(force = false) {
    if (cardReady && !force) return canvas;
    try {
      await document.fonts?.ready;
    } catch {
      /* ignore */
    }
    const drawn = await drawShareCard();
    cardReady = Boolean(drawn);
    return drawn;
  }

  async function changeStyle(delta) {
    layoutIndex = (layoutIndex + delta + cardLayouts.length) % cardLayouts.length;
    updateStyleLabel();
    cardReady = false;
    await ensureShareCard(true);
  }

  shareToggle?.addEventListener('click', async () => {
    if (!(sharePanel instanceof HTMLElement) || !(shareToggle instanceof HTMLButtonElement)) return;
    const willOpen = sharePanel.hidden;
    sharePanel.hidden = !willOpen;
    shareToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    if (willOpen) {
      try {
        if (!catalog) await loadCatalog();
        await loadThemes();
      } catch {
        showFeedback('No se pudo preparar la imagen. Revisa tu conexión.');
        return;
      }
      await ensureShareCard(true);
      sharePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  stylePrev?.addEventListener('click', () => changeStyle(-1));
  styleNext?.addEventListener('click', () => changeStyle(1));

  copyBtn?.addEventListener('click', async () => {
    try {
      if (!shareText) await loadCatalog();
      await navigator.clipboard.writeText(shareText);
      if (copyLabel) copyLabel.textContent = '¡Copiado!';
      showFeedback('Texto copiado al portapapeles.');
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copiar texto';
      }, 2200);
    } catch {
      showFeedback('No se pudo copiar. Inténtalo de nuevo.');
    }
  });

  downloadBtn?.addEventListener('click', async () => {
    try {
      if (!catalog) await loadCatalog();
      await loadThemes();
    } catch {
      showFeedback('No se pudo preparar la imagen. Revisa tu conexión.');
      return;
    }
    const drawn = await ensureShareCard();
    if (!(drawn instanceof HTMLCanvasElement) || !reading) return;
    const link = document.createElement('a');
    link.download = `versiculo-del-dia-${reading.day}.png`;
    link.href = drawn.toDataURL('image/png');
    link.click();
    showFeedback('Imagen descargada.');
  });

  if (copyImageBtn instanceof HTMLButtonElement && typeof ClipboardItem !== 'undefined') {
    copyImageBtn.hidden = false;
    copyImageBtn.addEventListener('click', async () => {
      try {
        if (!catalog) await loadCatalog();
        await loadThemes();
        const drawn = await ensureShareCard();
        if (!(drawn instanceof HTMLCanvasElement)) return;
        const blob = await canvasToBlob(drawn);
        if (!blob) throw new Error('blob');
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
        if (copyImageLabel) copyImageLabel.textContent = '¡Imagen copiada!';
        showFeedback('Imagen copiada al portapapeles.');
        window.setTimeout(() => {
          if (copyImageLabel) copyImageLabel.textContent = 'Copiar imagen';
        }, 2200);
      } catch {
        showFeedback('No se pudo copiar la imagen. Usa “Descargar imagen”.');
      }
    });
  }

  const refresh = () => {
    loadCatalog().catch(() => {
      /* SSR fallback remains visible until the next successful fetch */
    });
  };

  function msUntilNextMexicoMidnight(from = new Date()) {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Mexico_City',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
      hourCycle: 'h23',
    }).formatToParts(from);
    const get = (type) => Number(parts.find((part) => part.type === type)?.value);
    const elapsed =
      ((get('hour') * 60 + get('minute')) * 60 + get('second')) * 1000 +
      (from.getMilliseconds() || 0);
    return 86_400_000 - elapsed + 1500;
  }

  function scheduleMidnightRefresh() {
    window.setTimeout(() => {
      location.reload();
    }, msUntilNextMexicoMidnight());
  }

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(refresh, { timeout: 900 });
  } else {
    window.setTimeout(refresh, 120);
  }
  scheduleMidnightRefresh();
</script>
